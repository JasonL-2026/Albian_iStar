<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SICDataSource">
      <DataSourceReference>/PROD/Albian D6 Dispatch/Auxiliary/Data Sources/DispatchDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>e99af5f9-378c-4d63-a8a3-4bb0b5c1f3b8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSICAllLoadsDumps">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartShift">
            <Value>=Parameters!StartShift.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndShift">
            <Value>=Parameters!EndShift.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP 100000
       [ShiftStartTimestamp]
      ,[FullShiftName]
      ,[ShiftId]
      ,[Crew]
      ,[Excav]
      ,[Truck]
      ,[TruckOper]
      ,[LoadPit]
      ,[LoadLocation]
      ,[Unit]
      ,[Region]
      ,[DUnit]
      ,[FieldGpsxtkl]
      ,[FieldGpsytkl]
      ,[AssignTimestamp]
      ,[ArriveTimestamp]
      ,[LoadingTimestamp]
      ,[LoadingTimeStampNext]
      ,[LoadingTimestampGap]
      ,[FullTimestamp]
      ,[EmptyExpectedDistance]
      ,[EmptyHaullDistance]
      ,[EmptyCalcDuration]
      ,[EmptyPathDuration]
      ,[EmptyExpectedDuration]
      ,[EmptyHaulDuration]
      ,[SpotTime]
      ,[LoadingTime]
      ,[QueueTimeShvl]
      ,[HangTime]
      ,[DumpLocation]
      ,[FieldGpsxtkd]
      ,[FieldGpsytkd]
      ,[DumpArriveTimestamp]
      ,[DumpingTimestamp]
      ,[EmptyTimestamp]
      ,[FullExpectedDistance]
      ,[FullHaulDistance]
      ,[FullCalcDuration]
      ,[FullPathDuration]
      ,[FullExpectedDuration]
      ,[FullHaulDuration]
      ,[FullHaulMins]
      ,[QueueTimeDmp]
      ,[DumpSpotTime]
      ,[DumpingTime]
      ,[IsExtraload]
      ,[FieldElock]
      ,[fieldDlock]
      ,[MaterialType]
      ,[MaterialGroupName]
      ,[Category]
      ,[Grade]
      ,[Bit]
      ,[U2]
      ,[Fines]
      ,[U74]
      ,[D10]
      ,[D90]
      ,[D50]
      ,[MeasuredTon]
      ,[Tonnage]
  FROM [ASEOperational].[dispowner].[SIC_AllLoadsDumps]
  WHERE TRY_CONVERT(int, [ShiftId]) BETWEEN @StartShift AND @EndShift</CommandText>
      </Query>

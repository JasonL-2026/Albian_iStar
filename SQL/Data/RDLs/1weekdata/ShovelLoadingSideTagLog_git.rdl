<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SICDataSource">
      <DataSourceReference>/PROD/Albian D6 Dispatch/Auxiliary/Data Sources/DispatchDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0b9b4c81-5884-42bb-8608-acf60e41e0cb</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CurrentShift">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT CAST(
    FORMAT(
        CASE WHEN DATEPART(HOUR, GETDATE()) &lt; 6
             THEN DATEADD(DAY, -1, GETDATE())
             ELSE GETDATE()
        END,
        'yyMMdd'
    ) +
    CASE WHEN DATEPART(HOUR, GETDATE()) &gt;= 6
              AND DATEPART(HOUR, GETDATE()) &lt; 18
         THEN '001'
         ELSE '002'
    END
AS INT) AS CurrentShiftId;</CommandText>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="CurrentShiftId">
          <DataField>CurrentShiftId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PeriodPresets">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT 'Current Month' AS PresetLabel,
       CAST(FORMAT(DATEFROMPARTS(YEAR(GETDATE()),MONTH(GETDATE()),1),'yyMMdd')+'001' AS INT) AS StartShiftId,
       CAST(FORMAT(EOMONTH(GETDATE()),'yyMMdd')+'002' AS INT) AS EndShiftId
UNION ALL
SELECT 'Previous Month' AS PresetLabel,
       CAST(FORMAT(DATEFROMPARTS(YEAR(DATEADD(MONTH,-1,GETDATE())),MONTH(DATEADD(MONTH,-1,GETDATE())),1),'yyMMdd')+'001' AS INT) AS StartShiftId,
       CAST(FORMAT(EOMONTH(DATEADD(MONTH,-1,GETDATE())),'yyMMdd')+'002' AS INT) AS EndShiftId
UNION ALL
SELECT 'Current Shift' AS PresetLabel,
       CAST(FORMAT(CASE WHEN DATEPART(HOUR,GETDATE())&lt;6 THEN DATEADD(DAY,-1,GETDATE()) ELSE GETDATE() END,'yyMMdd')+CASE WHEN DATEPART(HOUR,GETDATE())&gt;=6 AND DATEPART(HOUR,GETDATE())&lt;18 THEN '001' ELSE '002' END AS INT) AS StartShiftId,
       CAST(FORMAT(CASE WHEN DATEPART(HOUR,GETDATE())&lt;6 THEN DATEADD(DAY,-1,GETDATE()) ELSE GETDATE() END,'yyMMdd')+CASE WHEN DATEPART(HOUR,GETDATE())&gt;=6 AND DATEPART(HOUR,GETDATE())&lt;18 THEN '001' ELSE '002' END AS INT) AS EndShiftId
UNION ALL
SELECT 'Last Week' AS PresetLabel,
       CAST(FORMAT(DATEADD(DAY,-(DATEPART(WEEKDAY,GETDATE())+5)%7-7,CAST(GETDATE() AS DATE)),'yyMMdd')+'001' AS INT) AS StartShiftId,
       CAST(FORMAT(DATEADD(DAY,-(DATEPART(WEEKDAY,GETDATE())+5)%7-1,CAST(GETDATE() AS DATE)),'yyMMdd')+'002' AS INT) AS EndShiftId</CommandText>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="PresetLabel">
          <DataField>PresetLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartShiftId">
          <DataField>StartShiftId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="EndShiftId">
          <DataField>EndShiftId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsShovelLoadingSideTagLog">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT [ShiftID]
      ,[Timestamp]
      ,[Excav]
      ,[Loadside]
      ,[Hos]
      ,[Material]
      ,[Status]
      ,[Operator]
FROM [ASEOperational].[CommonASE].[ShovelLoadingSideTagLog]
WHERE TRY_CONVERT(int, [ShiftID]) BETWEEN @StartShift AND @EndShift</CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartShift">
            <Value>=Parameters!StartShift.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndShift">
            <Value>=Parameters!EndShift.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="ShiftID">
          <DataField>ShiftID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Timestamp">
          <DataField>Timestamp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Excav">
          <DataField>Excav</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Loadside">
          <DataField>Loadside</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Hos">
          <DataField>Hos</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Operator">
          <DataField>Operator</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="StartShift">
      <DataType>Integer</DataType>
      <Prompt>Start Shift</Prompt>
      <DefaultValue>
        <Values>
          <Value>=CInt(Format(DateAdd(&quot;d&quot;, -((DatePart(&quot;w&quot;, Now()) + 5) Mod 7) - 7, Now()), &quot;yyMMdd&quot;) &amp; &quot;001&quot;)</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
    <ReportParameter Name="EndShift">
      <DataType>Integer</DataType>
      <Prompt>End Shift</Prompt>
      <DefaultValue>
        <Values>
          <Value>=CInt(Format(IIf(Hour(Now())&lt;6,DateAdd(&quot;d&quot;,-1,Now()),Now()),&quot;yyMMdd&quot;) &amp; IIf(Hour(Now())&gt;=6 And Hour(Now())&lt;18,&quot;001&quot;,&quot;002&quot;))</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
  </ReportParameters>

 --     ,[FieldFueltank]
 --     ,[FieldSignid]
 --     ,[FieldReason]
 --     ,[FieldLinereason]
 --     ,[FieldUnit]
 --     ,[FieldUnitloc]
 --     ,[FieldUnitlocnext]
 --     ,[FieldActlast]
 --     ,[FieldActnext]
 --     ,[FieldActsim]
 --     ,[FieldStatus]
 --     ,[FieldLoad]
 --     ,[FieldPort]
 --     ,[FieldPrior]
 --     ,[FieldLinestat]
 --     ,[FieldLogin]
 --     ,[FieldPriorore]
 --     ,[FieldPriorwaste]
 --     ,[FieldRetorque]
 --     ,[FieldEqmttype]
 --     ,[FieldNoassign]
 --     ,[FieldTram]
 --     ,[FieldLastload]
 --     ,[FieldSignpost]
 --     ,[FieldDoublespot]
 --     ,[FieldVsmstbl]
 --     ,[FieldComment]
 --     ,[FieldLinecmt]
 --     ,[FieldIrbeacon]
 --     ,[FieldTramload]
 --     ,[FieldFreearrive]
 --     ,[FieldSaveprior]
 --     ,[FieldDist]
 --     ,[FieldEfh]
 --     ,[FieldXloc]
 --     ,[FieldYloc]
 --     ,[FieldRadius]
 --     ,[FieldGpstype]
 --     ,[FieldLpeqmt]
 --     ,[FieldTramschedule]
 --     ,[FieldDiglock]
 --     ,[FieldVelocity]
 --     ,[FieldHeading]
 --     ,[FieldDirection]
 --     ,[FieldTiedownaccepted]
 --     ,[FieldPropfeed]
 --     ,[FieldZ]
 --     ,[FieldShoveldist]
 --     ,[FieldDumpdist]
 --     ,[FieldLaststatustime]
 --     ,[FieldLaststatreason]
 --     ,[FieldTiedownproposed]
 --     ,[FieldThreshold]
 --     ,[FieldMinout]
 --     ,[FieldTiretime]
 --     ,[FieldTirectrl]
 --     ,[FieldDumpasntime]
 --     ,[FieldShovelfulltime]
 --     ,[FieldLastbreak]
 --     ,[FieldCuroper]
 --     ,[FieldCurscope]
 --     ,[FieldCurbreak]
 --     ,[FieldOrigasnexcav]
 --     ,[FieldOrigasnloc]
 --     ,[FieldReasnby]
 --     ,[FieldPathtime]
 --     ,[FieldQueuesize]
 --     ,[FieldTimequeue]
 --     ,[FieldPantoready]
 --     ,[FieldExptraveldist]
 --     ,[FieldExptraveltime]
 --     ,[FieldGpstraveldist]
 --     ,[FieldLoadtype]
 --     ,[FieldFsgroup]
 --     ,[FieldGloc]
 --     ,[FieldHpgps]
 --     ,[FieldPv3sup]
 --     ,[FieldLastrftagtime]
 --     ,[FieldActpoly]
 --     ,[FieldPrestartdone]
 --     ,[FieldPresunit]
 --     ,[FieldPandh]
 --     ,[FieldFirstdipper]
 --     ,[FieldLastdipper]
 --     ,[FieldBktcnt]
 --     ,[FieldCnt]
 --     ,[FieldPantoid]
 --     ,[FieldPantouploc]
 --     ,[FieldPantoupdist]
 --     ,[FieldPantoupvel]
 --     ,[FieldPantotime]
 --     ,[FieldPantoerror]
 --     ,[FieldShvfirstbkt]
 --     ,[FieldShvlastbkt]
 --     ,[FieldShvbktcnt]
 --     ,[FieldWstation]
 --     ,[FieldLocaction]
 --     ,[FieldLvsproxcnt]
 --     ,[FieldTdowntime]
  --   ,[FieldGpsok]
 --     ,[FieldStart]
 --     ,[FieldLastgpsupdate]
 --     ,[FieldTdbar]
 --     ,[FieldTdrelease]
 --     ,[FieldIgnunexarr]
 --     ,[FieldFueled]
 --     ,[FieldFueltime]
 --     ,[FieldFuelfact]
 --     ,[FieldOemfueltime]
 --     ,[FieldHdwtype]
 --     ,[FieldServiceshop]
 --     ,[FieldMaintdate]
 --     ,[FieldLastservicedate]
 --     ,[FieldMainthours]
 --     ,[FieldEnghr]
 --     ,[FieldEnghr2]
 --     ,[FieldEnghrtime]
 --     ,[FieldEnghrtime2]
 --     ,[FieldEqreq]
 --     ,[FieldIsauxil]
 --     ,[FieldDumping]
 --     ,[FieldPmid]
 --     ,[FieldDevver]
 --     ,[FieldDevhw]
 --     ,[FieldDevbc]
 --     ,[FieldDevop]
 --     ,[FieldLoadside]
 --     ,[FieldLoadsidelk]
 --     ,[FieldRuntime]
 --     ,[FieldFuelenghr]
 --     ,[FieldFuelenghr2]
 --     ,[FieldIntf_data]
 --     ,[FieldRulelasttime]
  FROM [ASEOperational].[dbo].[PITTruck]

  Inner join
[ASEOperational].[Common].[EnumSTATUS]

on [ASEOperational].[dbo].[PITTruck].FieldStatus = [ASEOperational].[Common].[EnumSTATUS].Id

Where Description not like 'Down'

and (fieldid like 'T1%' or fieldid like 'T4%')


union all


SELECT 
FieldID
,[ASEOperational].[Common].[EnumSTATUS].[Description]
,FieldStatus
,dateadd(s,FieldLastgpsupdate,'1970-01-01') as LastGPSUpdate
,datediff(s,dateadd(s,FieldLastgpsupdate,'1970-01-01'),getdate()) as t



  FROM [ASEOperational].[dbo].[PITauxeqmt]

  Inner join
[ASEOperational].[Common].[EnumSTATUS]

on [ASEOperational].[dbo].[PITauxeqmt].FieldStatus = [ASEOperational].[Common].[EnumSTATUS].Id


Where Description not like 'Down'

and (fieldid like 'G%' or fieldid like 'D4%' or fieldid like 'D5%' or fieldid like 'D2%')
and Fieldid not like 'G77%' and Fieldid not like 'GD%'


union all

SELECT 
FieldID
,[ASEOperational].[Common].[EnumSTATUS].[Description]
,FieldStatus
,dateadd(s,FieldLastgpsupdate,'1970-01-01') as LastGPSUpdate
,datediff(s,dateadd(s,FieldLastgpsupdate,'1970-01-01'),getdate()) as t


  FROM [ASEOperational].[dbo].[PITexcav]

  Inner join
[ASEOperational].[Common].[EnumSTATUS]

on [ASEOperational].[dbo].[PITexcav].FieldStatus = [ASEOperational].[Common].[EnumSTATUS].Id


Where Description not like 'Down'
and fieldid not like 'BH%' and fieldid  not like 'S9%' 

) as A

left outer join

(select *
from
[ASEOperational].[dbo].[ShiftEqmtlistASE]
where shiftid = (select max(shiftid) from [ASEOperational].[dbo].[ShiftEqmtlistASE])
)as E
on A.FieldId = E.FieldId

where a.t &gt;= 60
and year(a.LastGPSUpdate)&gt;= 2024
and e.pit IN (@Area)

</CommandText>
      </Query>
      <Fields>
        <Field Name="FieldID">
          <DataField>FieldID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldStatus">
          <DataField>FieldStatus</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="LastGPSUpdate">
          <DataField>LastGPSUpdate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="t">
          <DataField>t</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ShiftId">
          <DataField>ShiftId</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="FieldId">
          <DataField>FieldId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Eqmttype">
          <DataField>Eqmttype</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Unit">
          <DataField>Unit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="WrongArrive">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
	   [Pit]
      ,[Truck]
      ,[WrongArrival]
      ,[ExpectedArrival]
      ,count([TIMESTAMP]) as Count
   
  FROM [ASEOperational].[dispowner].[WrongShovelArrive]
Where pit IN (@Area)
 and ShiftID =  (select max(shiftid) from ASEOperational.Common.ShiftInfo (nolock))

  group by
	   [Pit]
      ,[Truck]
      ,[WrongArrival]
      ,[ExpectedArrival]</CommandText>
      </Query>
      <Fields>
        <Field Name="Truck">
          <DataField>Truck</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WrongArrival">
          <DataField>WrongArrival</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExpectedArrival">
          <DataField>ExpectedArrival</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Count">
          <DataField>Count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DumpArrive">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>



with DumpAutoArrive as
(
SELECT 

      [Pit]
      ,[DumpLoc]
	  ,avg(DumpX) as DumpX
	  ,avg(DumpY) as DumpY
      ,sum(Case when ArriveType like 'Manual%' then 1 else 0 end) as ManualArrive
	  ,sum(Case when ArriveType like 'NO%' then 1 else 0 end) as NOGPS
	  ,sum(Case when ArriveType like 'AUTO%' then 1 else 0 end) as AutoArrive
      ,count([ArriveTime]) as TotalArrive

  FROM [ASEOperational].[dispowner].[ManualvsAutoArriveDumps]
  WHERE isExtraload = 0
  GROUP By     
		[Pit]
       ,[DumpLoc]
)
,
LastLoad as
(
Select 
 Ref.Pit
 ,Ref.DumpLoc
 ,XY.DumpX
 ,XY.DumpY
From
  (SELECT
      [Pit]
      ,[DumpLoc]

	  ,MIN(RN) as RN

  FROM [ASEOperational].[dispowner].[ManualvsAutoArriveDumps]
  WHERE 
		isExtraload = 0
		and DumpX is not null
		
    GROUP By     
		[Pit]
       ,[DumpLoc]) as Ref

	inner join  [ASEOperational].[dispowner].[ManualvsAutoArriveDumps] as XY
	on Ref.DumpLoc = XY.DumpLoc and Ref.RN = XY.RN

)

SELECT
       Pitloc.PitName
      ,PitLoc.[FieldId] as DumpLoc
	  ,PitLoc.Status
      ,PitLoc.[FieldXloc] as LocX
      ,PitLoc.[FieldYloc] as LocY
	  --,DumpAutoArrive.DumpX as DumpXAvg
	  --,DumpAutoArrive.DumpY as DumpYAvg
	  --,DistAvg = sqrt(power(cast(PitLoc.FieldXloc as bigint) - cast(DumpAutoArrive.DumpX as bigint),2) + power(cast(PitLoc.Fieldyloc as bigint) - cast(DumpAutoArrive.DumpY as bigint),2))
	  ,LastLoad.DumpX as DumpXLastLoad
	  ,LastLoad.DumpY as DumpYLastLoad
	  ,DistLastTrk = sqrt(power(cast(PitLoc.FieldXloc as bigint) - cast(LastLoad.DumpX as bigint),2) + power(cast(PitLoc.Fieldyloc as bigint) - cast(LastLoad.DumpY as bigint),2))
	  ,case when PitLoc.FieldRadius &lt;&gt; 0 then 'Circular Beacon ' + cast(PitLoc.FieldRadius as varchar) + ' m'
			when PitLoc.FieldRadius = 0 and PitLoc.FieldSignid &lt;&gt; 65535 then 'Polygon'
			when PitLoc.FieldRadius = 0 and PitLoc.FieldSignid = 65535 then 'NONE' end as Beaconsize
	  ,PitLoc.FieldSignpost as AutoArriveOn
	  ,isnull(DumpAutoArrive.ManualArrive,0) as ManualArrive
	  ,isnull(DumpAutoArrive.NOGPS,0) as NOGPS
	  ,isnull(DumpAutoArrive.AutoArrive,0) as AutoArrive
	  ,isnull(DumpAutoArrive.TotalArrive,0) as TotalArrive
	
  FROM [ASEOperational].[std].[StdPitloc] as PitLoc

 left outer join DumpAutoArrive on PitLoc.fieldid = DumpAutoArrive.DumpLoc
  inner join LastLoad on PitLoc.fieldid = LastLoad.DumpLoc

 where
 PitLoc.[FieldId] not like '%_REJ' and PitLoc.[FieldID] not like 'IN_ROADS%'

 --left(excav.fieldid,3) in ('S00', 'S80', 'S01','S25', 'S30')
--and excav.fieldid not like 'S005'
 --and (excav.status like 'Ready' or excav.status like 'Delay')
and Pitname in (@Area)
 order by PitLoc.fieldid

</CommandText>
      </Query>
      <Fields>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DumpLoc">
          <DataField>DumpLoc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LocX">
          <DataField>LocX</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LocY">
          <DataField>LocY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DumpXLastLoad">
          <DataField>DumpXLastLoad</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DumpYLastLoad">
          <DataField>DumpYLastLoad</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DistLastTrk">
          <DataField>DistLastTrk</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Beaconsize">
          <DataField>Beaconsize</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AutoArriveOn">
          <DataField>AutoArriveOn</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="ManualArrive">
          <DataField>ManualArrive</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="NOGPS">
          <DataField>NOGPS</DataField>

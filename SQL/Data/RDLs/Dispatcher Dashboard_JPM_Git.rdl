                                    <Paragraph>
                                      <TextRuns>
                                        <TextRun>
                                          <Value>=IIf(Sum(Fields!AvgPayload797.Value) &gt; 0, "797's: " + FormatNumber(Sum(Fields!AvgPayload797.Value * Fields!NumLoads797.Value) / Sum(Fields!NumLoads797.Value), 1) + Microsoft.VisualBasic.Constants.vbcrlf, "") + IIf(Sum(Fields!AvgPayload789.Value) &gt; 0, "789's: " + FormatNumber(Sum(Fields!AvgPayload789.Value * Fields!NumLoads789.Value) / Sum(Fields!NumLoads789.Value), 1) + Microsoft.VisualBasic.Constants.vbcrlf, "") + IIf(Sum(Fields!AvgPayload785.Value) &gt; 0, "785's: " + FormatNumber(Sum(Fields!AvgPayload785.Value * Fields!NumLoads785.Value) / Sum(Fields!NumLoads785.Value), 1) + Microsoft.VisualBasic.Constants.vbcrlf, "") + IIf(Sum(Fields!AvgPayload777.Value) &gt; 0, "777's: " + FormatNumber(Sum(Fields!AvgPayload777.Value * Fields!NumLoads777.Value) / Sum(Fields!NumLoads777.Value), 1) + Microsoft.VisualBasic.Constants.vbcrlf, "") + IIf(Sum(Fields!AvgPayloadOther.Value) &gt; 0, "Others: " + FormatNumber(Sum(Fields!AvgPayloadOther.Value * Fields!NumLoadsOther.Value) / Sum(Fields!NumLoadsOther.Value), 1), "")</Value>

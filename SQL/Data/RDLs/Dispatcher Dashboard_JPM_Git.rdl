 --     ,[FieldBean]
 --     ,[FieldSize]
 --     ,[FieldFuelamt]
 --     ,[FieldTons]
 --     ,[FieldSimcode]
 --     ,[FieldSendcount]
 --     ,[FieldRcvcount]
 --     ,[FieldTime1]

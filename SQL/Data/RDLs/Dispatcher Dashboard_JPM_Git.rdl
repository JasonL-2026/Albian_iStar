    <DataSet Name="Blend">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
;with gradeinfo as
(
 SELECT ga.Id, ga.[Value] as [Bit], 0.0 as [Fines], 0.0 as [D50], 0.0 as [MBI]
 FROM dbo.SHIFTShiftgradeGradesArray (NOLOCK) ga 
  INNER JOIN [Common].[EnumGRADE] eg on eg.[idx] = ga.[index] and eg.Abbreviation = 'BIt'
 UNION ALL
 SELECT ga.Id, 0 as [Bit], ga.[Value] as [Fines], 0.0 as [D50], 0.0 as [MBI]
 FROM dbo.SHIFTShiftgradeGradesArray (NOLOCK)  ga 
  INNER JOIN [Common].[EnumGRADE] eg on eg.[idx] = ga.[index] and eg.Abbreviation = 'U44'
 UNION ALL
 SELECT ga.Id, 0 as [Bit], 0.0 as [Fines], ga.[Value] as [D50], 0.0 as [MBI]
 FROM dbo.SHIFTShiftgradeGradesArray (NOLOCK) ga 
  INNER JOIN [Common].[EnumGRADE] eg on eg.[idx] = ga.[index] and eg.Abbreviation = 'D50'
 UNION ALL
 SELECT ga.Id, 0 as [Bit], 0.0 as [Fines], 0.0 as [D50], ga.[Value] as [MBI]
 FROM dbo.SHIFTShiftgradeGradesArray (NOLOCK)  ga 
  INNER JOIN [Common].[EnumGRADE] eg on eg.[idx] = ga.[index] and eg.Abbreviation = 'MBI'
),
dumps 
as
(
 SELECT 
  ShiftDumps.DumpingTimestamp
  ,ShiftDumps.ShiftId 
  ,ShiftDumps.pit
  ,ShiftDumps.DumpLocationUnit
  ,ShiftDumps.[Excav]
  ,ShiftDumps.[Grade]
  ,ShiftDumps.GradeId
  ,ShiftDumps.MaterialType
  ,Tonnage as Tons
  --,case 
  --  when shiftDumps.[Tons] = 0 
  --   then shiftdumps.Tonnage
  --  when ShiftDumps.[Tons] &gt; 1.2 * ShiftDumps.Tonnage 
  --   then 1.2 * Tonnage
  --  when ShiftDumps.[Tons] &lt; 0.7 * ShiftDumps.Tonnage
  --   then .7 * Tonnage
  --  else ShiftDumps.Tons end AS Tons
--  ,ShiftDumps.Tons
  ,ShiftInfo.ShiftStartTimestamp ShiftStartTimestamp2
  ,ShiftInfo.FullShiftName FullShiftName2
  ,ShiftStartSecSinceMidnight
 FROM std.StdShiftdumps AS ShiftDumps with(nolock)
 LEFT OUTER JOIN 
  [Common].ShiftInfo AS ShiftInfo with(nolock) 
 ON ShiftDumps.ShiftId = ShiftInfo.ShiftId 
 WHERE 
  ShiftDumps.Shiftid = (Select top 1 shiftid from common.shiftinfo order by shiftid desc) and ShiftDumps.pit IN (@Area)
  and DumpLocationUnit = 'Crusher'

)
,excavgrade 
as
(
 SELECT   
   [Excav]
  ,[Grade]
  ,ShiftDumps.MaterialType
  ,ShiftDumps.ShiftId
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons ELSE 0 END ) as float) AS Hour00
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons*[Bit] ELSE 0 END ) as float) AS B00
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons*[Fines] ELSE 0 END ) as float) AS F00
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons*[D50] ELSE 0 END ) as float) AS D00
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons*[MBI] ELSE 0 END ) as float) AS M00
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons ELSE 0 END ) as float) AS Hour01  
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons*[Bit] ELSE 0 END ) as float) AS B01
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons*[Fines] ELSE 0 END ) as float) AS F01
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons*[D50] ELSE 0 END ) as float) AS D01
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons*[MBI] ELSE 0 END ) as float) AS M01
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons ELSE 0 END ) as float) AS Hour02  
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons*[Bit] ELSE 0 END ) as float) AS B02
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons*[Fines] ELSE 0 END ) as float) AS F02
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons*[D50] ELSE 0 END ) as float) AS D02
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons*[MBI] ELSE 0 END ) as float) AS M02
  ,sum(Tons) AS TotalHours
  ,sum(Tons*[Bit]) as TotalBit
  ,sum(Tons*[Fines]) as TotalFine
  ,sum(Tons*[D50]) as TotalD50
  ,sum(Tons*[MBI]) as TotalMBI
  
 FROM dumps AS ShiftDumps with(nolock)  
 join 
 (select id, sum([Bit]) as [Bit]
 ,sum(Fines) [Fines]
 ,sum(D50) as [D50]
 ,sum(MBI) as [MBI] from gradeinfo group by [id]) as gi on gi.Id = ShiftDumps.GradeId
 GROUP BY
   [Excav],
   grade,
   ShiftDumps.MaterialType,
   ShiftDumps.ShiftId 
)
,excav
as
(
 SELECT   
   [Excav]   
  ,sum(Tons) Tons 
  ,ShiftDumps.ShiftId 
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 2 THEN Tons  ELSE 0 END ) as float) AS Hour00  
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 1 THEN Tons  ELSE 0 END ) as float) AS Hour01  
  ,cast(sum(CASE WHEN ((DATEDIFF(ss, '1970-01-01', dateadd(hour,datediff(hour,0,dateadd(hour, 1, getdate())),0)) - DATEDIFF(ss, '1970-01-01', DumpingTimestamp)) / 3600) = 0 THEN Tons  ELSE 0 END ) as float) AS Hour02
  ,sum(Tons) as TotalHours  

 FROM dumps ShiftDumps
 GROUP BY
   [Excav] , 
   ShiftDumps.ShiftId
)
,allinfo
as(
 SELECT DISTINCT
  FullShiftName
  ,CONVERT(varchar, DATEADD(s, ShiftStartSecSinceMidnight, 0), 108) AS StartShiftTime
 , dateadd(hour,datediff(hour,0,dateadd(hour, -2, getdate())),0) AS Hour00Start
  ,excav
  ,eg.grade
  ,eg.MaterialType
  ,Hour00 
  ,(case when Hour00 = 0 then 0 else Hour00 / (Select sum(Hour00) from excav e ) end ) as PercBlockHour00
  ,B00
  ,F00
  ,D00
  ,M00
  ,Hour01
  ,(case when Hour01 = 0 then 0 else Hour01 / (Select sum(Hour01) from excav e ) end ) as PercBlockHour01
  ,B01
  ,F01 
  ,D01
  ,M01
  ,Hour02
  ,(case when Hour02 = 0 then 0 else Hour02 / (Select sum(Hour02) from excav e ) end ) as PercBlockHour02
  ,B02 
  ,F02 
  ,D02
  ,M02
  ,TotalHours
  ,(case when TotalHours = 0 then 0 else TotalHours / (Select sum(TotalHours) from excav e ) end ) as PercBlockTotalHour
  , TotalBit
  , TotalFine
  , TotalD50
  , TotalMBI
  
 FROM 
  excavgrade eg
 INNER JOIN 
  Common.ShiftInfo i 
  ON eg.ShiftId =i.ShiftId
)

 SELECT DISTINCT
  FullShiftName
  ,StartShiftTime
  ,Hour00Start
  ,excav
  ,grade
  ,MaterialType
  ,Hour00
  ,PercBlockHour00
  ,B00
  ,F00
  ,D00
  ,M00
  ,Hour01
  ,PercBlockHour01
  ,B01
  ,F01
  ,D01
  ,M01
  ,Hour02
  ,PercBlockHour02
  ,B02
  ,F02
  ,D02
  ,M02
  ,TotalHours
  ,PercBlockTotalHour
  ,TotalBit
  ,TotalFine
  ,TotalD50
  ,TotalMBI
 FROM allinfo</CommandText>
      </Query>
      <Fields>
        <Field Name="FullShiftName">
          <DataField>FullShiftName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartShiftTime">
          <DataField>StartShiftTime</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Hour00Start">
          <DataField>Hour00Start</DataField>

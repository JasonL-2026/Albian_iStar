        </Field>
        <Field Name="TotalArrive">
          <DataField>TotalArrive</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="RouteClosure">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT [Pit]
      ,[PrevDumpLocation]
      ,[LoadLocation]
      ,[Excav]
      ,[ExpectedEmptyDistance]
      ,[ActualEmptyDistance]
      ,[Count]
      ,[LocationFrom]
      ,[LocationTo]
      ,[Direction]
  FROM [ASEOperational].[dispowner].[LongEmptyHaulvsRouteClosure]

where Pit IN (@Area) and ExpectedEmptyDistance &gt;=10000</CommandText>
      </Query>
      <Fields>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PrevDumpLocation">
          <DataField>PrevDumpLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LoadLocation">
          <DataField>LoadLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Excav">
          <DataField>Excav</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExpectedEmptyDistance">
          <DataField>ExpectedEmptyDistance</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ActualEmptyDistance">
          <DataField>ActualEmptyDistance</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Count">
          <DataField>Count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LocationFrom">
          <DataField>LocationFrom</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LocationTo">
          <DataField>LocationTo</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Direction">
          <DataField>Direction</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LubelandEquipment">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
	case when [loc].FieldId = PJS.NextLocation and reason.FieldName not like '%wait%' then 1
	     when [loc].FieldId = PJS.NextLocation and reason.fieldName like '%wait%' then 2
		 when [loc].FieldId = PJS.NextLocation and reason.fieldName is null then 3
		 when [loc].FieldId &lt;&gt; PJS.NextLocation then 4
		 else 5 end as sort,
	a.FieldId as Truck,
--	PJS.LastLocation,	
	[loc].FieldId CurrentLocation,
	PJS.NextLocation,
	case when [loc].FieldId = PJS.NextLocation then reason.FieldName else'En-Route' end as Reason,
	case when [loc].FieldId = PJS.NextLocation then 'Arrived' else 'En-Route' end as Category,
	(StdTruck.fieldtimenext-( select top 1 shiftduration from aseoperational.common.shiftinfo order by shiftid desc))/60.0 as MinsRemain,
	PJS.NextShovelAssignment,
	PJS.Projection,
	[loc].Fieldpit,
	[PitName].FieldId Area,
	[OEqmt].[FieldName] WorkerName,
   iif( a.FieldFueltank=0,0,    (ISNULL(a.FieldFueltank,0)- ISNULL(a.FieldFuelamt,0))/(ISNULL(a.FieldFueltank,0))) as RemainFuelPercent
  
FROM dbo.PITTruck a with(nolock)
LEFT OUTER JOIN dbo.PITTruckTiedownArray  [PitTruckTiedown] with(nolock) 
ON 
	[PitTruckTiedown].Id = a.Id
	AND [PitTruckTiedown].[Index] = 0
LEFT OUTER JOIN std.StdPitloc pitloc with(nolock)
ON 
	[PitTruckTiedown].[Value] = pitloc.Id
LEFT OUTER JOIN dbo.PITWorker [OEqmt] with(nolock)
ON 
	[OEqmt].[Id] = a.[FieldCuroper]
LEFT OUTER JOIN Common.EnumSTATUS [Status] with(nolock)
ON 
	[Status].Id = a.FieldStatus
LEFT OUTER JOIN dbo.PITPitloc [loc] with(nolock) 
ON 
	[loc].Id = a.FieldLoc
LEFT OUTER JOIN dbo.PITPitloc [PitName] with(nolock) 
ON 
	[PitName].dbkey = [loc].fieldpit
LEFT OUTER JOIN dbo.Enum [Load] with(nolock) 
ON 
	[Load].Id = a.FieldLoad

LEFT OUTER join [ASEOperational].[dispowner].[ProjectedTruckAssignments] as PJS with (nolock)
on a.FieldId = PJS.Truck

LEFT OUTER Join [ASEOperational].[std].[StdTruck] StdTruck
on a.FieldId = StdTruck.FieldId

left outer join std.StdReasonDelay reason
on reason.FieldId=a.FieldReason


Where ([PitName].FieldId IN (@Area))  

and ([loc].FieldId like '%lube%' or PJS.NextLocation like '%lube%')
--and reason.FieldName like '%fuel%'

and [status].[description] not like 'Down'

order by case when [loc].FieldId = PJS.NextLocation and reason.FieldName not like '%wait%' then 1
	     when [loc].FieldId = PJS.NextLocation and reason.fieldName like '%wait%' then 2
		 when [loc].FieldId = PJS.NextLocation and reason.fieldName is null then 3
		 when [loc].FieldId &lt;&gt; PJS.NextLocation then 4
		 else 5 end </CommandText>
      </Query>
      <Fields>
        <Field Name="sort">
          <DataField>sort</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Truck">
          <DataField>Truck</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrentLocation">
          <DataField>CurrentLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NextLocation">
          <DataField>NextLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Reason">
          <DataField>Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinsRemain">
          <DataField>MinsRemain</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NextShovelAssignment">
          <DataField>NextShovelAssignment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Projection">
          <DataField>Projection</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fieldpit">
          <DataField>Fieldpit</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Area">
          <DataField>Area</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkerName">
          <DataField>WorkerName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RemainFuelPercent">
          <DataField>RemainFuelPercent</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="FuelLevelFault">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT  FC.[Pit]
      ,FC.[Eqmttype]
      ,FC.[Truck]
      ,FC.[FieldStatus]
      ,FC.[LastReadTime]
      ,FC.[LastGPSUpdate]
      ,FC.[FuelLvl]
      ,FC.[FieldFueltank]
      ,FC.[FuelAmount]
	  
	  ,Datediff(hour, LastFuel.Timestamp,Fc.LastGPSUpdate) as Hour

	
  FROM [ASEOperational].[dispowner].[TruckFuelSensorCheck] as FC

  inner join
  [ASEOperational].[CommonASE].[TruckLastFuel] as LastFuel

  on FC.truck = LastFuel.Eqmt

where FC.pit in (@Area)</CommandText>
      </Query>
      <Fields>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Eqmttype">
          <DataField>Eqmttype</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Truck">
          <DataField>Truck</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldStatus">
          <DataField>FieldStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastReadTime">
          <DataField>LastReadTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="LastGPSUpdate">
          <DataField>LastGPSUpdate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FuelLvl">
          <DataField>FuelLvl</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FieldFueltank">
          <DataField>FieldFueltank</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="FuelAmount">
          <DataField>FuelAmount</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Hour">
          <DataField>Hour</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>

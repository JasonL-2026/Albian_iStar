    <DataSet Name="CrusherInfo">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>With materialASE AS
( 
	SELECT DISTINCT
	ShiftId
	,Excav
	,Truck
	,Tonnage = Sum(AlbianTonnage)
	,QueueTimeCr = Sum(CASE
        WHEN left(DumpLocation,2) LIKE 'CR%' THEN QueueTimeDmp
        ELSE 0
        END)
	,CrTonnes = Sum(CASE
        WHEN left(DumpLocation,2) LIKE 'CR%' THEN AlbianTonnage
        ELSE 0
        END)
	,LoadsCr = Sum(CASE
        WHEN left(DumpLocation,2) LIKE 'CR%' THEN 1
        ELSE 0
        END)
	FROM 
		std.stdShiftMaterialDescriptionASE
	WHERE 
		ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
		AND Pit IN (@Area)
	GROUP BY 
		ShiftId, Excav, Truck
),

cteEqmtTruck AS
(
	SELECT
		ShiftId
		,FieldId
		,EqmtType
		,Pit
		
	FROM 
		std.stdshifteqmt
		
	Where std.stdshifteqmt.ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
		AND std.stdshifteqmt.Pit IN (@Area)
		AND std.stdshifteqmt.Unit = 'Truck'
		AND FieldId NOT LIKE 'T5%'
		AND FieldId NOT LIKE 'T6%'
		AND FieldId NOT LIKE 'T9%'
)

SELECT
	cteEqmtTruck.ShiftId
	,cteEqmtTruck.FieldId
	,cteEqmtTruck.Eqmttype
	,cteEqmtTruck.Pit
	,materialASE.QueueTimeCr
	,materialASE.LoadsCr
	,materialASE.CrTonnes
	

FROM 
	cteEqmtTruck

FULL JOIN materialASE 
	ON cteEqmtTruck.ShiftId = materialASE.ShiftId 
	AND cteEqmtTruck.FieldId = materialASE.Truck

	
--OPTION (QUERYTRACEON 9481)
--OPTION (FORCE ORDER)
OPTION (RECOMPILE)</CommandText>
      </Query>
      <Fields>
        <Field Name="ShiftId">
          <DataField>ShiftId</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="FieldId">
          <DataField>FieldId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Eqmttype">
          <DataField>Eqmttype</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="QueueTimeCr">
          <DataField>QueueTimeCr</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="LoadsCr">
          <DataField>LoadsCr</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CrTonnes">
          <DataField>CrTonnes</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Fuel">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT top (10)
	a.FieldId as Truck,
	case when Fuelsensor.truck is null then a.FieldID else Concat(a.FieldId, '-bad sensor') end as FieldId,
	Fuelsensor.Hour,
	a.FieldSize,
	a.FieldFueltank - a.FieldFuelamt FuelRemaining, 
	ISNULL(a.FieldFueltank,0) FieldFueltank, 
	a.FieldFuelamt, 
	a.FieldFueled, 
	a.FieldFuelfact, 
	a.FieldPanelid, 
	[Status].[Description] [Status], 
	[Load].[Description] [Load], 
	a.FieldLogin LoginId,
	pitloc.FieldId Tiedown, 
	a.FieldEnghr,
	[Status].TxtColor, 
	[Status].BgColor, 
	PJS.LastLocation,	
	[loc].FieldId CurrentLocation,
	PJS.NextLocation,
	(StdTruck.fieldtimenext-( select top 1 shiftduration from aseoperational.common.shiftinfo order by shiftid desc))/60.0 as MinsRemain,
	PJS.NextShovelAssignment,
	PJS.Projection,
	[loc].Fieldpit,
	[PitName].FieldId Area,
	[OEqmt].[FieldName] WorkerName,
   iif( a.FieldFueltank=0,0,    (ISNULL(a.FieldFueltank,0)- ISNULL(a.FieldFuelamt,0))/(ISNULL(a.FieldFueltank,0))) as RemainFuelPercent
        
FROM dbo.PITTruck a with(nolock)
LEFT OUTER JOIN dbo.PITTruckTiedownArray  [PitTruckTiedown] with(nolock) 
ON 
	[PitTruckTiedown].Id = a.Id
	AND [PitTruckTiedown].[Index] = 0
LEFT OUTER JOIN std.StdPitloc pitloc with(nolock)
ON 
	[PitTruckTiedown].[Value] = pitloc.Id
LEFT OUTER JOIN dbo.PITWorker [OEqmt] with(nolock)
ON 
	[OEqmt].[Id] = a.[FieldCuroper]
LEFT OUTER JOIN Common.EnumSTATUS [Status] with(nolock)
ON 
	[Status].Id = a.FieldStatus
LEFT OUTER JOIN dbo.PITPitloc [loc] with(nolock) 
ON 
	[loc].Id = a.FieldLoc
LEFT OUTER JOIN dbo.PITPitloc [PitName] with(nolock) 
ON 
	[PitName].dbkey = [loc].fieldpit
LEFT OUTER JOIN dbo.Enum [Load] with(nolock) 
ON 
	[Load].Id = a.FieldLoad

LEFT OUTER join [ASEOperational].[dispowner].[ProjectedTruckAssignments] as PJS with (nolock)
on a.FieldId = PJS.Truck

LEFT OUTER Join [ASEOperational].[std].[StdTruck] StdTruck
on a.FieldId = StdTruck.FieldId

left outer join

(
SELECT  FC.[Pit]
      ,FC.[Eqmttype]
      ,FC.[Truck]
      ,FC.[FieldStatus]
      ,FC.[LastReadTime]
      ,FC.[LastGPSUpdate]
      ,FC.[FuelLvl]
      ,FC.[FieldFueltank]
      ,FC.[FuelAmount]
	  ,Datediff(hour, LastFuel.Timestamp,Fc.LastGPSUpdate) as Hour

  FROM [ASEOperational].[dispowner].[TruckFuelSensorCheck] as FC

  inner join
  [ASEOperational].[CommonASE].[TruckLastFuel] as LastFuel

  on FC.truck = LastFuel.Eqmt
) as Fuelsensor
on a.FieldId = Fuelsensor.Truck

Where ([PitName].FieldId IN (@Area)) 

and [status].[description] not like 'Down'

ORDER BY 
	(ISNULL(a.FieldFueltank,0)- ISNULL(a.FieldFuelamt,0))/IIF(a.fieldfueltank=0,1,(ISNULL(a.FieldFueltank,1)))</CommandText>
      </Query>
      <Fields>
        <Field Name="RemFuelColor">
          <Value>=1+(switch
(
Fields!FieldFueltank.Value &lt;= 0 OR Fields!FuelRemaining.Value &lt; 0, l.o.c("sNA",Parameters!Lang.Value),
Fields!FieldFueltank.Value &gt; 0 AND Fields!FuelRemaining.Value &gt;= 0, Fields!FuelRemaining.Value,
Fields!FieldFueltank.Value &gt; 0 OR Fields!FuelRemaining.Value &lt; 0, l.o.c("sNA",Parameters!Lang.Value) 
)-Fields!FieldFueltank.Value)/Fields!FieldFueltank.Value</Value>
        </Field>
        <Field Name="Truck">
          <DataField>Truck</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldId">
          <DataField>FieldId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Hour">
          <DataField>Hour</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="FieldSize">
          <DataField>FieldSize</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FuelRemaining">
          <DataField>FuelRemaining</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FieldFueltank">
          <DataField>FieldFueltank</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="FieldFuelamt">
          <DataField>FieldFuelamt</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FieldFueled">
          <DataField>FieldFueled</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
        <Field Name="FieldFuelfact">
          <DataField>FieldFuelfact</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="FieldPanelid">
          <DataField>FieldPanelid</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Load">
          <DataField>Load</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LoginId">
          <DataField>LoginId</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Tiedown">
          <DataField>Tiedown</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldEnghr">
          <DataField>FieldEnghr</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TxtColor">
          <DataField>TxtColor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BgColor">
          <DataField>BgColor</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LastLocation">
          <DataField>LastLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrentLocation">
          <DataField>CurrentLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NextLocation">
          <DataField>NextLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MinsRemain">
          <DataField>MinsRemain</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="NextShovelAssignment">
          <DataField>NextShovelAssignment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Projection">
          <DataField>Projection</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Fieldpit">
          <DataField>Fieldpit</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Area">
          <DataField>Area</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkerName">
          <DataField>WorkerName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RemainFuelPercent">
          <DataField>RemainFuelPercent</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ASE_Delay">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @currentshift int
  set @currentshift= ( select top 1 shiftduration from aseoperational.common.shiftinfo order by shiftid desc)
/****** Script for SelectTopNRows command from SSMS  ******/
SELECT 
(a.fieldtimenext-@currentshift)/60.0 as mins,
a.workername,
c.FieldName as reason,
b.PitName,
a.fieldid as unit,
PJS.Load as Material,
PJS.NextLocation,
PJS.NextShovelAssignment,
PJS.Projection

FROM [ASEOperational].[std].[StdTruck] a  

left join std.stdpitloc b 
on a.CurrentLocationId=b.Id 

left join std.StdReasonDelay c 
on a.status='Delay' and c.FieldId=a.FieldReason

Inner join [ASEOperational].[dispowner].[ProjectedTruckAssignments] as PJS with (nolock)
on a.FieldId = PJS.Truck

where a.Status='Delay' AND (b.pitname IN (@Area))

union all

SELECT 
(a.fieldtimenext-@currentshift)/60.0 as mins,
a.workername,c.FieldName as reason,
b.PitName,
a.fieldid as unit,
null as Material,
null as NextLocation,
null as NextShovelAssignment,
null as Projection
  
FROM [ASEOperational].[std].[Stdauxeqmt] a  

left join std.stdpitloc b 
on a.CurrentLocationId=b.Id 

left join std.StdReasonDelay c 
on a.status='Delay' and c.FieldId=a.FieldReason

where a.Status='Delay' AND (b.pitname IN (@Area))</CommandText>
      </Query>
      <Fields>
        <Field Name="mins">
          <DataField>mins</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="workername">
          <DataField>workername</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="reason">
          <DataField>reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="unit">
          <DataField>unit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Material">
          <DataField>Material</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NextLocation">
          <DataField>NextLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NextShovelAssignment">
          <DataField>NextShovelAssignment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Projection">
          <DataField>Projection</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Trucks">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>Select
 std.stdtruck.Fieldid
 ,Lastexcav
 ,PitName
From std.stdtruck
Left join std.stdpitloc on currentlocation = std.stdpitloc.fieldid

where pitname IN (@Area)
and left(std.stdtruck.fieldid,2) in ('T1','T4')

order by std.stdtruck.fieldid</CommandText>
      </Query>
      <Fields>
        <Field Name="Fieldid">
          <DataField>Fieldid</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Lastexcav">
          <DataField>Lastexcav</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ShovelLoc">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @ShiftStartDateTime datetime
declare @ShiftEndDateTime datetime
declare @StartShift int = (Select top (1) shiftid from common.shiftinfo order by shiftid desc)

select 
	@ShiftStartDateTime = ShiftStartDateTime
FROM Common.ShiftInfo AS ShiftInfo_2
WHERE 
	--ShiftId = @Shiftid
	ShiftId = @StartShift

select 
	@ShiftEndDateTime = DATEADD(ss, ShiftDuration, ShiftStartDateTime) 
FROM Common.ShiftInfo 
WHERE      
	--ShiftId = @Shiftid;
	ShiftId = @StartShift;

With transactions as
(
SELECT
	   log1.[Id]
      ,log1.[TIMESTAMP]
      ,log1.[MESSAGEBODY]
	  ,log2.prevMessage
	  ,CASE 
		WHEN 
			messagebody like '%arrived at shovel%' and prevMessage like '%SIGNPOST'+Substring(messagebody, charindex('arrived at ', messagebody) + LEN('arrived at '), len(messagebody))+'%' then 'Yes' else 'No' end as AutoArriveShovel
			
	  ,CASE 
		WHEN 
			messagebody like '%arrived at crusher%' and prevMessage like '%'+Substring(messagebody, charindex('arrived at ', messagebody) + LEN('arrived at '), len(messagebody))+'%' then 'Yes' else 'No' end as AutoArriveCrusher

	 , Substring(messagebody, charindex('Shovel ',messagebody) + 7,charindex('.',messagebody) - charindex('Shovel ',messagebody)-7) as Shovel
	 , Substring(messagebody, charindex('arrive',messagebody) - 5,4) as Truck

FROM [ASEOperational].[DispatchLog].[TransactionLog] log1 with(nolock)

Left JOIN 
(
Select 
	   log.[Id]
	  ,lag(messagebody) over (order by id) as prevMessage
From [ASEOperational].[DispatchLog].[TransactionLog] log with(nolock)
where log.messagebody like '%arrive%'
and timestamp between @ShiftStartDateTime and @ShiftEndDateTime
) log2

on log2.id = log1.id

Left join std.stdshifteqmt on fieldid = Substring(messagebody, charindex('arrive',messagebody) - 5,4) and shiftid = @StartShift
 
where log1.messagebody like '%arrived at%'
and timestamp between @ShiftStartDateTime and @ShiftEndDateTime
),

ShovelAutoArrive as
(
Select
 Shovel
,sum(CASE WHEN messagebody like '%arrived at shovel%' then 1 else 0 end) as ArriveShovel
,Sum(CASE WHEN AutoArriveShovel = 'Yes' Then 1 else 0 end) as AutoArriveShovel
From transactions

Where left(shovel,3) in ('S00', 'S80', 'S01', 'S250','S30')

Group by Shovel
)

SELECT
       excav.[FieldId]
	  ,PitName
      ,[CurrentLocation]
      ,excav.[FieldXloc] as ExcavX
      ,excav.[FieldYloc] as ExcavY
	  ,loc.FieldXloc as LocX
	  ,loc.FieldYloc as LocY
	  ,Dist = sqrt(power(cast(excav.FieldXloc as bigint) - cast(loc.FieldXloc as bigint),2) + power(cast(excav.Fieldyloc as bigint) - cast(loc.Fieldyloc as bigint),2))
      ,excav.FieldRadius as beaconsize
	  ,excav.FieldSignpost as AutoArrive
	  ,AutoArriveShovel
	  ,ArriveShovel
  FROM [ASEOperational].[std].[Stdexcav] excav

  Left Join [std].[StdPitloc] loc on loc.fieldid = CurrentLocation
  Left join ShovelAutoArrive on excav.fieldid = ShovelAutoArrive.Shovel

 where left(excav.fieldid,3) in ('S00', 'S80', 'S01','S25', 'S30')
 and excav.status = 'Ready'
and pitname in (@Area)
 order by fieldid</CommandText>
      </Query>
      <Fields>
        <Field Name="FieldId">
          <DataField>FieldId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrentLocation">
          <DataField>CurrentLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExcavX">
          <DataField>ExcavX</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ExcavY">
          <DataField>ExcavY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LocX">
          <DataField>LocX</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="LocY">
          <DataField>LocY</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Dist">
          <DataField>Dist</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="beaconsize">
          <DataField>beaconsize</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AutoArrive">
          <DataField>AutoArrive</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
        <Field Name="AutoArriveShovel">
          <DataField>AutoArriveShovel</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ArriveShovel">
          <DataField>ArriveShovel</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Roads">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
       [Locstart]
      ,[Locend]
      ,[FieldDist]
	  ,locstart.FieldZloc as StartElevation
	  ,locend.FieldZloc as EndElevation
	  ,100.0*(locend.FieldZloc - locstart.FieldZloc)/FieldDist as Grade
	  ,locstart.PitName
      
  FROM [ASEOperational].[std].[StdTravel]

  Left join std.stdpitloc locstart on locstart.fieldid = Locstart
  Left join std.stdpitloc locend on locend.fieldid = Locend

where locstart.pitname in (@Area)</CommandText>
      </Query>
      <Fields>
        <Field Name="Locstart">
          <DataField>Locstart</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Locend">
          <DataField>Locend</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldDist">
          <DataField>FieldDist</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="StartElevation">
          <DataField>StartElevation</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="EndElevation">
          <DataField>EndElevation</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Grade">
          <DataField>Grade</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="OnCall">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <CommandText>SELECT 
	[Aux].FieldId EquipmentName, 
  	Loc.FieldId CurrentLocation,
	Worker.WorkerName,
	Worker.Comment,
	OEqmt.FieldName CurrentWorkerName,
	[Status].Description AS [Status], 
    [PitName].FieldId Area,
	PhoneNumber,
Name

FROM dbo.PITAuxeqmt Aux
LEFT JOIN dbo.Enum AS [Unit] with(nolock) 
ON 
	[Unit].Id = [Aux].FieldUnit
LEFT JOIN dbo.PITPitloc Loc
ON 
	Loc.Id = Aux.FieldLoc

LEFT OUTER JOIN dbo.PITPitloc [PitName] with(nolock) 
ON 
	[PitName].dbkey = Loc.fieldpit


LEFT JOIN dbo.Enum AS [Status] with(nolock) 
ON 
	[Status].Id = Aux.FieldStatus

OUTER APPLY
(
	SELECT TOP 1
		luw.FieldName WorkerName,
		luw.FieldLcomment Comment
	FROM dbo.PITWorkerAuxeqmtArray pa with(nolock)
	INNER JOIN dbo.PITWorker luw with(nolock)
	ON
		pa.Id = luw.Id
	WHERE
		pa.Value = Aux.Id
		AND pa.[Index] = 2
	ORDER BY
		luw.Id
) Worker
LEFT JOIN dbo.PITWorker AS OEqmt 
ON 
	Aux.FieldCurOper = OEqmt.Id

LEFT JOIN dbo.ContactsASE on Payroll = OEqmt.Fieldid

Where [Aux].FieldId = 'SUPT_ONCALL'</CommandText>
      </Query>
      <Fields>
        <Field Name="EquipmentName">
          <DataField>EquipmentName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrentLocation">
          <DataField>CurrentLocation</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="WorkerName">
          <DataField>WorkerName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Comment">
          <DataField>Comment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CurrentWorkerName">
          <DataField>CurrentWorkerName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Area">
          <DataField>Area</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PhoneNumber">
          <DataField>PhoneNumber</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DumpArrivals">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>declare @ShiftStartDateTime datetime
declare @ShiftEndDateTime datetime
declare @StartShift int = (Select top (1) shiftid from common.shiftinfo order by shiftid desc)

select 
	@ShiftStartDateTime = ShiftStartDateTime
FROM Common.ShiftInfo AS ShiftInfo_2
WHERE 
	--ShiftId = @Shiftid
	ShiftId = @StartShift

select 
	@ShiftEndDateTime = DATEADD(ss, ShiftDuration, ShiftStartDateTime) 
FROM Common.ShiftInfo 
WHERE      
	--ShiftId = @Shiftid;
	ShiftId = @StartShift;

With transactions as
(
SELECT
	   log1.[Id]
      ,log1.[TIMESTAMP]
      ,log1.[MESSAGEBODY]
	  ,log2.prevMessage
			
	  ,CASE 
		WHEN 
			messagebody like '%arrived at crusher%' and prevMessage like '%'+Substring(messagebody, charindex('arrived at ', messagebody) + LEN('arrived at '), len(messagebody))+'%' then 'Yes' else 'No' end as AutoArriveCrusher
     ,CASE 
		WHEN 
			messagebody like '%arrived at dump%' and prevMessage like '%'+Substring(messagebody, charindex('arrived at ', messagebody) + LEN('arrived at '), len(messagebody))+'%' then 'Yes' else 'No' end as AutoArriveDump

	 , Substring(messagebody, charindex('Dump ',messagebody) + 5,charindex('.',messagebody) - charindex('Dump ',messagebody)-5) as Dump
	 , Substring(messagebody, charindex('Crusher ',messagebody) + 8,charindex('.',messagebody) - charindex('Crusher ',messagebody)-8) as Crusher
	 , Substring(messagebody, charindex('arrive',messagebody) - 5,4) as Truck

FROM [ASEOperational].[DispatchLog].[TransactionLog] log1 with(nolock)

Left JOIN 
(
Select 
	   log.[Id]
	  ,lag(messagebody) over (order by id) as prevMessage
From [ASEOperational].[DispatchLog].[TransactionLog] log with(nolock)
where log.messagebody like '%arrive%'
and timestamp between @ShiftStartDateTime and @ShiftEndDateTime
) log2

on log2.id = log1.id
 
where log1.messagebody like '%arrived at%'
and timestamp between @ShiftStartDateTime and @ShiftEndDateTime
),

DumpAutoArrive as
(
Select
 Dump
,sum(CASE WHEN messagebody like '%arrived at dump%' then 1 else 0 end) as ArriveDump
,Sum(CASE WHEN AutoArriveDump = 'Yes' Then 1 else 0 end) as AutoArriveDump
From transactions

Where left(dump,2) in ('DU', 'DY')
Group by dump

Union

Select
 Crusher
,sum(CASE WHEN messagebody like '%arrived at crusher%' then 1 else 0 end) as ArriveDump
,Sum(CASE WHEN AutoArriveCrusher = 'Yes' Then 1 else 0 end) as AutoArriveDump
From transactions

Where left(crusher,2) = ('CR')
Group by crusher
)

SELECT
		fieldid as dump
	   ,PitName
	   ,AutoArriveDump
	   ,ArriveDump
                   ,FieldSignpost as AutoArriveOn
  FROM std.stdpitloc dump


  Left join DumpAutoArrive on fieldid = DumpAutoArrive.Dump

 where dump.status = 'Ready'
 and unit in ('Crusher','Dump')
 and left(fieldid, 2) in ('Cr','Du','Dy')
 and right(fieldid,3) &lt;&gt; 'REJ'
 and pitname in (@Area)</CommandText>
      </Query>
      <Fields>
        <Field Name="dump">
          <DataField>dump</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AutoArriveDump">
          <DataField>AutoArriveDump</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ArriveDump">
          <DataField>ArriveDump</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="AutoArriveOn">
          <DataField>AutoArriveOn</DataField>
          <rd:TypeName>System.Int16</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="AutovsManualGrade">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
SELECT 
       LD.GN
	  ,SP.Pit
	  ,LD.[Shovel]
      ,LD.[GradeGPS]
	  ,LD.[MTGPS]
     -- ,LD.[MGGPS]
      ,LD.[GradeOPER]
	  ,LD.[MTOPER]
     -- ,LD.[MGOPER]
      ,LD.[Category]
      ,LD.[StartTime]
      ,LD.[Endtime]
      ,LD.[Minutes]
      ,LD.[LoadCount]
  FROM [ProVision35].[dbo].[PV3_AutoVsManualLoads] as LD

	inner join
	(select

	e.fieldid as Shovel
	,l.Pitname as Pit

	from
	ASEOperational.rpt.Pitloc l with(nolock)

	inner join
	ASEOperational.std.stdexcav e with(nolock)
	on l.fieldid = e.CurrentLocation) as SP
 

   ON LD.shovel = SP.Shovel
 
	

  WHERE LD.endtime &gt; dateadd(hour,-2,getdate())
and SP.Pit in (@Area)
--  and shovel in ('S804','S808','S011')
 -- and mtoper is not null
  and LD.GN &lt;= 1

  --order by shovel,endtime desc</CommandText>
      </Query>
      <Fields>
        <Field Name="GN">
          <DataField>GN</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shovel">
          <DataField>Shovel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GradeGPS">
          <DataField>GradeGPS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MTGPS">
          <DataField>MTGPS</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GradeOPER">
          <DataField>GradeOPER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MTOPER">
          <DataField>MTOPER</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Category">
          <DataField>Category</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartTime">
          <DataField>StartTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Endtime">
          <DataField>Endtime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Minutes">
          <DataField>Minutes</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="LoadCount">
          <DataField>LoadCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ManualArrive">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
--alter view rpt.TruckAutoArriveSummaryASE as 


SELECT

TA.ShiftID
,TA.Pit
--,Loads.MaterialGroupName


--,TA.SignPostBefore
--,TA.SignPostAfter
--,TA.Truck
,Loads.TruckOperatorName
---,CASE 
--WHEN TA.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OperName
--,TA.ARRIVETYPE
,SUM(CASE WHEN TA.Arrivetype like 'AUTOARRIVE' then 1 ELSE 0 END) as AutoArrive
,SUM(CASE WHEN TA.Arrivetype like 'NGA' then 1 ELSE 0 END) as ManualNoGPS
,SUM(CASE WHEN TA.Arrivetype like 'MANUAL EARLY' then 1 ELSE 0 END) as ManualEarly
--,cast(Datepart(month,Ta.arrivetime) as varchar) + cast(datepart(day,ta.arrivetime) as varchar) + cast(datepart(hour,ta.arrivetime)as varchar) as TimeLabel 

--,AVG(TA.Seconds) as SecondsEarly
--,AVG(Loads.QueueTime) as QueueTime
--,AVG(Loads.SpotTime) as SpotTime
--,AVG(Loads.LoadingTime) as LoadingTime

--,Dumps.QueueTime as DumpQueue



FROM
(
SELECT 
TA.ShiftID
,PitName as Pit
--,CASE 
--WHEN TA.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OperName
,TA.Truck
,TA.Arrived
,TA.Signpost as SignPostBefore
,TA.SignPost1 as SignPostAfter
,TA.ArriveTime
,TA.ArriveType
,TA.AutoArriveTime
,TA.Seconds


FROM
(
SELECT
TR1.shiftID
--,PitName AS PIT
--,CASE 
--WHEN TR1.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OPERNAME
,TR1.TRUCK
,TR1.ARRIVED
,TR2.SIGNPOST
,TR3.SIGNPOST AS SIGNPOST1,
TR1.TimestampRnd as ARRIVETIME
,CASE
WHEN TR2.SIGNPOST = TR1.ARRIVED THEN 'AUTOARRIVE'
WHEN TR3.SIGNPOST = TR1.ARRIVED AND TR3.TimestampRnd = TR1.TimestampRnd THEN 'AUTOARRIVE'
WHEN TR3.SIGNPOST = TR1.ARRIVED AND TR3.TimestampRnd &lt;&gt; TR1.TimestampRnd THEN 'MANUAL EARLY'
--WHEN TR2.SIGNPOST &lt;&gt; TR1.ARRIVED AND TR3.SIGNPOST &lt;&gt; TR1.ARRIVED THEN 'MANUAL NORMAL'
ELSE 'NGA' END AS ARRIVETYPE

,CASE
WHEN TR2.SIGNPOST = TR1.ARRIVED THEN TR2.TIMESTAMPRND
WHEN TR3.SIGNPOST = TR1.ARRIVED THEN TR3.TIMESTAMPRND 
ELSE null END AS AUTOARRIVETIME

,CASE
WHEN TR3.SIGNPOST = TR1.ARRIVED AND (TR2.SIGNPOST IS NULL OR TR2.SIGNPOST &lt;&gt;TR1.ARRIVED)
THEN CASE WHEN DATEDIFF(SECOND,TR1.TIMESTAMPRND,TR3.TIMESTAMPRND)&gt;0 THEN DATEDIFF(SECOND,TR1.TIMESTAMPRND,TR3.TIMESTAMPRND) ELSE 0 END
ELSE 0 END AS SECONDS


FROM

(SELECT TOP (10000) [Id]
    --  ,[TIMESTAMP]
	  ,ShiftID
      ,[TimestampRnd]
    --  ,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  
  ORDER BY ShiftID, TRUCK, ID) AS TR1

  LEFT OUTER JOIN 
  ( SELECT TOP (10000) [Id]
   --   ,[TIMESTAMP]
      ,[TimestampRnd]
      --,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  ORDER BY TRUCK, ID 
 ) AS TR2

--ON TR1.TRUCK = TR2.TRUCK AND TR1.RN=TR2.RN+1
ON TR1.RN=TR2.RN+1


 LEFT OUTER JOIN 
  ( SELECT TOP (10000) [Id]
   --   ,[TIMESTAMP]
      ,[TimestampRnd]
      --,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  ORDER BY TRUCK, ID 
 ) AS TR3

--ON TR1.TRUCK = TR2.TRUCK AND TR1.RN=TR2.RN+1
ON TR1.RN=TR3.RN-1





where 
tr1.arrived is not null
) TA


left join std.stdtruck on TA.Truck = std.stdtruck.FieldID
Left join std.stdpitloc on stdpitloc.fieldid = std.stdtruck.CurrentLocation

) TA

full outer join (Select truck, truckoperatorname, arrivetimestamp,[FullTimestamp], QueueTime,spottime, Loadingtime, MaterialGroupName, Materialtype, IsExtraload from std.stdshiftloads where shiftid = (select max(shiftid)from [ASEOperational].[Common].[ShiftInfo])  ) loads on TA.ARRIVETIME = loads.arrivetimestamp and TA.truck = loads.truck
--Left join (Select truck, truckoperatorname, arrivetimestamp, QueueTime from std.StdShiftDumps where shiftid = 231215001 ) dumps on TA.ARRIVETIME = dumps.arrivetimestamp and TA.truck = dumps.truck
--Left join  std.stdshiftdumps  dumps on TA.arrivetime  = dumps.arrivetimestamp and TA.truck = dumps.truck and TA.shiftid = dumps.ShiftId
where (TA.Arrived like 'S0%' or TA.Arrived like 'S8%' /*or TA.Arrived like 'S25%'*/)

and loads.FullTimestamp is not null
and TruckOperatorName is not null
and Pit IN (@Area)

--ORDER BY ta.TRUCK ,loads.FullTimestamp
Group by

TA.ShiftID
,TA.Pit
--,Loads.MaterialGroupName
--,Loads.MaterialType
--,TA.Arrived 
--,TA.SignPostBefore
--,TA.SignPostAfter
--,TA.Truck
,Loads.TruckOperatorName
---,CASE 
--WHEN TA.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OperName
--,TA.ArriveType

--,cast(Datepart(month,Ta.arrivetime) as varchar) + cast(datepart(day,ta.arrivetime) as varchar) + cast(datepart(hour,ta.arrivetime)as varchar) as TimeLabel 
--,TA.ArriveTime
--,TA.AutoArriveTime
--,FullTimestamp
--,TA.Seconds 
--,Loads.QueueTime
--,Loads.SpotTime
--,Loads.LoadingTime
--,IsExtraload

order by 

SUM(CASE WHEN TA.Arrivetype like 'MANUAL EARLY' then 1 ELSE 0 END) desc

--order by ta.arrived ,TA.ARRIVETIME ,loads.FullTimestamp

</CommandText>
      </Query>
      <Fields>
        <Field Name="ShiftID">
          <DataField>ShiftID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AutoArrive">
          <DataField>AutoArrive</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ManualNoGPS">
          <DataField>ManualNoGPS</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TruckOperatorName">
          <DataField>TruckOperatorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ManualEarly">
          <DataField>ManualEarly</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ManualArriveCycleTime">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>

SELECT

TA.ShiftID
,TA.Pit
--,Loads.MaterialGroupName
,Loads.MaterialType
,TA.Arrived as Shovel
--,TA.SignPostBefore
--,TA.SignPostAfter
,TA.Truck
,Loads.TruckOperatorName
---,CASE 
--WHEN TA.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OperName
,TA.ArriveType
--,cast(Datepart(month,Ta.arrivetime) as varchar) + cast(datepart(day,ta.arrivetime) as varchar) + cast(datepart(hour,ta.arrivetime)as varchar) as TimeLabel 
,TA.ArriveTime
,TA.AutoArriveTime
,FullTimestamp
,TA.Seconds as SecondsEarly
,Loads.QueueTime
,Loads.SpotTime
,Loads.LoadingTime
,IsExtraload
--,Dumps.QueueTime as DumpQueue



FROM
(
SELECT 
TA.ShiftID
,PitName as Pit
--,CASE 
--WHEN TA.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OperName
,TA.Truck
,TA.Arrived
,TA.Signpost as SignPostBefore
,TA.SignPost1 as SignPostAfter
,TA.ArriveTime
,TA.ArriveType
,TA.AutoArriveTime
,TA.Seconds


FROM
(
SELECT
TR1.shiftID
--,PitName AS PIT
--,CASE 
--WHEN TR1.ARRIVED LIKE 'S___' THEN LOADS.Truckoperatorname
--ELSE DUMPS.TruckOperatorName
--END AS OPERNAME
,TR1.TRUCK
,TR1.ARRIVED
,TR2.SIGNPOST
,TR3.SIGNPOST AS SIGNPOST1,
TR1.TimestampRnd as ARRIVETIME
,CASE
WHEN TR2.SIGNPOST = TR1.ARRIVED THEN 'AUTOARRIVE'
WHEN TR3.SIGNPOST = TR1.ARRIVED AND TR3.TimestampRnd = TR1.TimestampRnd THEN 'AUTOARRIVE'
WHEN TR3.SIGNPOST = TR1.ARRIVED AND TR3.TimestampRnd &lt;&gt; TR1.TimestampRnd THEN 'MANUAL EARLY'
--WHEN TR2.SIGNPOST &lt;&gt; TR1.ARRIVED AND TR3.SIGNPOST &lt;&gt; TR1.ARRIVED THEN 'MANUAL NORMAL'
ELSE 'No GPS' END AS ARRIVETYPE

,CASE
WHEN TR2.SIGNPOST = TR1.ARRIVED THEN TR2.TIMESTAMPRND
WHEN TR3.SIGNPOST = TR1.ARRIVED THEN TR3.TIMESTAMPRND 
ELSE null END AS AUTOARRIVETIME

,CASE
WHEN TR3.SIGNPOST = TR1.ARRIVED AND (TR2.SIGNPOST IS NULL OR TR2.SIGNPOST &lt;&gt;TR1.ARRIVED)
THEN CASE WHEN DATEDIFF(SECOND,TR1.TIMESTAMPRND,TR3.TIMESTAMPRND)&gt;0 THEN DATEDIFF(SECOND,TR1.TIMESTAMPRND,TR3.TIMESTAMPRND) ELSE 0 END
ELSE 0 END AS SECONDS


FROM

(SELECT TOP (10000) [Id]
    --  ,[TIMESTAMP]
	  ,ShiftID
      ,[TimestampRnd]
    --  ,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  
  ORDER BY ShiftID, TRUCK, ID) AS TR1

  LEFT OUTER JOIN 
  ( SELECT TOP (10000) [Id]
   --   ,[TIMESTAMP]
      ,[TimestampRnd]
      --,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  ORDER BY TRUCK, ID 
 ) AS TR2

--ON TR1.TRUCK = TR2.TRUCK AND TR1.RN=TR2.RN+1
ON TR1.RN=TR2.RN+1


 LEFT OUTER JOIN 
  ( SELECT TOP (10000) [Id]
   --   ,[TIMESTAMP]
      ,[TimestampRnd]
      --,[MESSAGETYPE]
      ,[MESSAGEBODY]
      ,[Truck]
      ,[ARRIVED]
      ,[SIGNPOST]
	  --,DENSE_RANK() OVER (PARTITION BY TRUCK ORDER BY ID) AS GN
	  --,DENSE_RANK() OVER (ORDER BY ID) AS GN
	  ,ROW_NUMBER() OVER (PARTITION BY TRUCK ORDER BY TRUCK,ID) AS GN
	  ,ROW_NUMBER() OVER (ORDER BY TRUCK,ID) AS RN
  FROM [ASEOperational].[rpt].[TruckAutoArriveASE]
  ORDER BY TRUCK, ID 
 ) AS TR3

--ON TR1.TRUCK = TR2.TRUCK AND TR1.RN=TR2.RN+1
ON TR1.RN=TR3.RN-1





where 
tr1.arrived is not null
) TA


left join std.stdtruck on TA.Truck = std.stdtruck.FieldID
Left join std.stdpitloc on stdpitloc.fieldid = std.stdtruck.CurrentLocation

) TA

full outer join (Select truck, truckoperatorname, arrivetimestamp,[FullTimestamp], QueueTime,spottime, Loadingtime, MaterialGroupName, Materialtype, IsExtraload from std.stdshiftloads where shiftid = (select max(shiftid)from [ASEOperational].[Common].[ShiftInfo])  ) loads on TA.ARRIVETIME = loads.arrivetimestamp and TA.truck = loads.truck
--Left join (Select truck, truckoperatorname, arrivetimestamp, QueueTime from std.StdShiftDumps where shiftid = 231215001 ) dumps on TA.ARRIVETIME = dumps.arrivetimestamp and TA.truck = dumps.truck
--Left join  std.stdshiftdumps  dumps on TA.arrivetime  = dumps.arrivetimestamp and TA.truck = dumps.truck and TA.shiftid = dumps.ShiftId
where (TA.Arrived like 'S0%' or TA.Arrived like 'S8%' /*or TA.Arrived like 'S25%'*/)

and loads.FullTimestamp is not null
and TruckOperatorName is not null
and Pit IN (@Area)

--ORDER BY ta.TRUCK ,loads.FullTimestamp

--order by loads.TruckOperatorName ,loads.FullTimestamp

--order by ta.arrived ,TA.ARRIVETIME ,loads.FullTimestamp</CommandText>
      </Query>
      <Fields>
        <Field Name="ShiftID">
          <DataField>ShiftID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MaterialType">
          <DataField>MaterialType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Shovel">
          <DataField>Shovel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Truck">
          <DataField>Truck</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TruckOperatorName">
          <DataField>TruckOperatorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArriveType">
          <DataField>ArriveType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ArriveTime">
          <DataField>ArriveTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AutoArriveTime">
          <DataField>AutoArriveTime</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FullTimestamp">
          <DataField>FullTimestamp</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="SecondsEarly">
          <DataField>SecondsEarly</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="QueueTime">
          <DataField>QueueTime</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="SpotTime">
          <DataField>SpotTime</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="LoadingTime">
          <DataField>LoadingTime</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="IsExtraload">
          <DataField>IsExtraload</DataField>
          <rd:TypeName>System.Byte</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EQMTGPS">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>/****** Script for SelectTopNRows command from SSMS  ******/
select *

from

(SELECT 
FieldID
,[ASEOperational].[Common].[EnumSTATUS].[Description]
,FieldStatus
,dateadd(s,FieldLastgpsupdate,'1970-01-01') as LastGPSUpdate
,datediff(s,dateadd(s,FieldLastgpsupdate,'1970-01-01'),getdate()) as t
 --,[DbPrevious]
 --     ,[DbNext]
 --     ,[DbVersion]
 --     --,[Id]
 --     ,[DbName]
 --     ,[DbKey]
 --     ,[FieldId]
 --     ,[FieldQueue]
 --     ,[FieldExcavnext]
 --     ,[FieldLoc]
 --     ,[FieldLocnext]
 --     ,[FieldExcavlock]
 --     ,[FieldDumplock]
 --     ,[FieldExcav]
 --     ,[FieldDumpasn]
 --     ,[FieldLocstart]
 --     ,[FieldLastloc]
 --     ,[FieldVan]
 --     ,[FieldRegionlock]
 --     ,[FieldLastexcav]
 --     ,[FieldBay]

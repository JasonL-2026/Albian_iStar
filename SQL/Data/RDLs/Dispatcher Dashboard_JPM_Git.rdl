<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>120</AutoRefresh>
  <DataSources>
    <DataSource Name="DispatchDataSource">
      <DataSourceReference>/Auxiliary/Data Sources/DispatchDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2b0b989a-f053-4bd4-b80f-0935ccd8bcd4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CurrentShift">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <CommandText>SELECT     TOP (1) FullShiftName
FROM         Common.ShiftInfo
ORDER BY ShiftStartTimestamp DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="FullShiftName">
          <DataField>FullShiftName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CurrentTruck">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
  std.StdTruck.FieldId
  ,std.StdTruck.Linestat
  ,std.stdtruck.FieldTons
  ,std.StdPitloc.PitName
FROM
  std.StdTruck
  
  LEFT OUTER JOIN std.StdPitloc
    ON std.StdTruck.CurrentLocation = std.StdPitloc.FieldId

WHERE std.stdpitloc.pitname IN (@Area)
AND std.stdtruck.Eqmttype IN ('Cat 797F', 'Cat 797B')</CommandText>
      </Query>
      <Fields>
        <Field Name="FieldId">
          <DataField>FieldId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Linestat">
          <DataField>Linestat</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldTons">
          <DataField>FieldTons</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="PitName">
          <DataField>PitName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ShiftTotals">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--With MatDesc AS
--( SELECT
--	shiftid
--	,Nextshiftdumpid
--	,AlbianTonnage

--FROM std.stdShiftMaterialDescriptionASE
--WHERE ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc) 
--)


--SELECT
--  std.StdShiftDumps.ShiftId
--  ,std.stdShiftDumps.ShiftStartTimestamp
--  ,std.StdShiftDumps.Tons
--  ,MatDesc.AlbianTonnage
--  ,std.StdShiftDumps.MaterialType
--  ,std.StdShiftDumps.Pit
--FROM
--  std.StdShiftDumps


--LEFT JOIN MatDesc ON std.StdShiftDumps.Id = MatDesc.NextShiftDumpId

--WHERE std.stdshiftdumps.ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
--AND std.stdshiftdumps.pit IN (@Area)


SELECT
   ShiftId
  ,ShiftStartTimestamp
  ,AlbianTonnage
  ,MaterialType
  ,Pit
FROM
  std.stdShiftMaterialDescriptionASE

WHERE ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
AND pit IN (@Area)
</CommandText>
      </Query>
      <Fields>
        <Field Name="ShiftId">
          <DataField>ShiftId</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ShiftStartTimestamp">
          <DataField>ShiftStartTimestamp</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="AlbianTonnage">
          <DataField>AlbianTonnage</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="MaterialType">
          <DataField>MaterialType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Shovels">
      <Query>
        <DataSourceName>DispatchDataSource</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Area">
            <Value>=Parameters!Area.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>with loadsum as 
(
 select sld.Excav
  , sld.ShiftId
  ,right(left(Eqmttype,7),3) Trucktype
  --ignore 0 tonnage loads when calculating avg payload, use measuretons instead of Albian Tonnes
  ,sum(case when sld.Tons = 0 then 0 else 1 end) as PayloadCount
  ,sum(sld.tons) as TotalPayloadTons
 from [std].[StdShiftLoads] sld with(nolock)
 join std.StdShifteqmt seq with(nolock)
  on sld.truckid = seq.Id 
 where sld.ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
 group by sld.shiftid, sld.excav, right(left(Eqmttype,7),3)
),
shiftdata as
(
 select ls.Excav
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '797' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload797
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '789' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload789
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '785' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload785
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '777' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload777
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype not in ('777', '785', '789', '797') then TotalPayloadTons/PayloadCount else 0 end) as AvgPayloadOther
  ,sum(case when Trucktype = '797' then PayloadCount else 0 end) as NumLoads797
  ,sum(case when Trucktype = '789' then PayloadCount else 0 end) as NumLoads789
  ,sum(case when Trucktype = '785' then PayloadCount else 0 end) as NumLoads785
  ,sum(case when Trucktype = '777' then PayloadCount else 0 end) as NumLoads777
  ,sum(case when Trucktype not in ('777', '785', '789', '797') then PayloadCount else 0 end) as NumLoadsOther

 from loadsum ls
 where ls.ShiftId = (Select top 1 shiftid from common.shiftinfo order by shiftid desc)
 group by  ls.Excav
), loadsumprev as 
(
 select sld.Excav
  , sld.ShiftId
  ,right(left(Eqmttype,7),3) Trucktype
  --ignore 0 tonnage loads when calculating avg payload, use measuretons instead of Albian Tonnes
  ,sum(case when sld.Tons = 0 then 0 else 1 end) as PayloadCount
  ,sum(sld.tons) as TotalPayloadTons
 from [std].[StdShiftLoads] sld with(nolock)
 join std.StdShifteqmt seq with(nolock)
  on sld.truckid = seq.Id 
 where sld.ShiftId = (Select 
	shiftid
	from (
		Select row_number() over (order by shiftid desc) as rownum, ShiftId
		from common.shiftinfo 
		) T
	where rownum = 2)
 group by sld.shiftid, sld.excav, right(left(Eqmttype,7),3)
),prevshift as
(
select lsp.Excav
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '797' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload797PrevShift
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '789' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload789PrevShift
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '785' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload785PrevShift
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype = '777' then TotalPayloadTons/PayloadCount else 0.0 end) as AvgPayload777PrevShift
  ,sum(case when PayloadCount = 0 then 0.0 when Trucktype not in ('777', '785', '789', '797') then TotalPayloadTons/PayloadCount else 0 end) as AvgPayloadOtherPrevShift
  ,sum(case when Trucktype = '797' then PayloadCount else 0 end) as NumLoads797Prev
  ,sum(case when Trucktype = '789' then PayloadCount else 0 end) as NumLoads789Prev
  ,sum(case when Trucktype = '785' then PayloadCount else 0 end) as NumLoads785Prev
  ,sum(case when Trucktype = '777' then PayloadCount else 0 end) as NumLoads777Prev
  ,sum(case when Trucktype not in ('777', '785', '789', '797') then PayloadCount else 0 end) as NumLoadsOtherPrev

 from loadsumprev lsp
 where lsp.ShiftId = 
	 (Select 
	shiftid
	from (
		Select row_number() over (order by shiftid desc) as rownum, ShiftId
		from common.shiftinfo 
		) T
	where rownum = 2)
	 group by  lsp.Excav
	 )

select 
--Colors and Shovel Group
case when r.[Type] = 'Ready'
	then 'Blue'
	when r.[Type] = 'Delay'
	then 'Yellow'
	when r.[Type] = 'Down'
	then 'Red'
	else 'White' end as BgColor
,case when r.[Type] = 'Ready'
	then 'White'
	when r.[Type] = 'Delay'
	then 'Black'
	when r.[Type] = 'Down'
	then 'White'
	else 'HotPink' end as TextColor
,case when Eqmttype = 'BE 495B2' then 'Cable Electric'
 when Eqmttype = 'HIT 8000' OR Eqmttype = 'HIT 2500' OR Eqmttype = 'Komatsu 3000' then 'Hydraulic'
 else 'Unknown' end as ShovelGroup
--Shovel ID
,e.Fieldid
,e.Eqmttype
--status
,r.[type] [Status]
,r.FieldName Reason
,case when datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate()) &gt; 604800
  then cast(convert(numeric(10,1), datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate())/604800.0) as varchar(200)) + ' Week(s)'
  when datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate()) &gt; 86400 
  then cast(convert(numeric(10,1), datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate())/86400.0) as varchar(200)) + ' Day(s)' 
  when datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate()) &gt; 3600 
  then cast(convert(numeric(10,1), datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate())/3600.0) as varchar(200)) + ' Hour(s)' 
  else cast(datediff(ss,dateadd(ss,e.FieldLaststatustime, '1970-01-01 00:00:00'), getdate())/60 as varchar(200)) + ' Minute(s)' end as LastStatTime 
--Material and Grade
,e.load
,isnull(e.CurrentGrade, 'NONE') as Grade
,isnull(g.Grade00, 0.0) as [Bit]
,isnull(g.Grade02, 0.0) as [Fines]
,isnull(g.Grade06, 0.0) as [D50]
--Surface and Elevation
 ,isnull(des.[Name], '-') as Current_Surface
 ,isnull(lep.PositionZ, 0.0) as Machine_Elevation
 ,isnull(sgs.Height, 0.0) as Target_Elevation
--Operator
,isnull(e.WorkerName, 'NONE') as Operator
--Avg Payload (per truck type)
 ,isnull(sd.AvgPayload797,0.0) as AvgPayload797
 ,isnull(sd.AvgPayload789,0.0) as AvgPayload789
 ,isnull(sd.AvgPayload785,0.0) as AvgPayload785
 ,isnull(sd.AvgPayload777,0.0) as AvgPayload777
 ,isnull(sd.AvgPayloadOther,0.0) as AvgPayloadOther
 ,isnull(sd.NumLoads797,0.0) as NumLoads797
 ,isnull(sd.NumLoads789,0.0) as NumLoads789
 ,isnull(sd.NumLoads785,0.0) as NumLoads785
 ,isnull(sd.NumLoads777,0.0) as NumLoads777
 ,isnull(sd.NumLoadsOther,0.0) as NumLoadsOther

  ,isnull(ps.AvgPayload797PrevShift,0.0) as AvgPayload797PrevShift
 ,isnull(ps.AvgPayload789PrevShift,0.0) as AvgPayload789PrevShift
 ,isnull(ps.AvgPayload785PrevShift,0.0) as AvgPayload785PrevShift
 ,isnull(ps.AvgPayload777PrevShift,0.0) as AvgPayload777PrevShift
 ,isnull(ps.AvgPayloadOtherPrevShift,0.0) as AvgPayloadOtherPrevShift
 ,isnull(ps.NumLoads797Prev,0.0) as NumLoads797Prev
 ,isnull(ps.NumLoads789Prev,0.0) as NumLoads789Prev
 ,isnull(ps.NumLoads785Prev,0.0) as NumLoads785Prev
 ,isnull(ps.NumLoads777Prev,0.0) as NumLoads777Prev
 ,isnull(ps.NumLoadsOtherPrev,0.0) as NumLoadsOtherPrev
from rpt.Excav e with(nolock)
left join rpt.Reasons r with(nolock) on r.FieldId = e.FieldReason and e.[Status] = r.[Type]
left join rpt.Grade g with(nolock) on g.id = e.CurrentGradeId
left join rpt.Pitloc l with(nolock) on l.id = e.CurrentLocationId
left join Provision35.IdentityManagement.ManagedEntity me with(nolock) on me.[Name] = e.FieldId
left join Provision35.AssignmentsOperational.Assignment asgn with(nolock) on asgn.ResourceID = me.ID
left join Provision35.PositionTrackingOperational.LastEquipmentPosition lep with(nolock) on asgn.ResourceID = lep.ManagedEntityID
left join Provision35.MineDesignOperational.Design des with(nolock) on asgn.WorkID = des.ID
left join Provision35.MineDesignOperational.SurfaceGrids sgs with(nolock) on des.SurfaceId = sgs.SurfaceID
    and round(lep.PositionX,0) = sgs.GridX
    and round(lep.PositionY,0) = sgs.GridY
left join shiftdata sd on sd.Excav = e.FieldId
left join prevshift ps on ps.Excav = e.FieldId
where l.PitName IN (@Area)</CommandText>
      </Query>

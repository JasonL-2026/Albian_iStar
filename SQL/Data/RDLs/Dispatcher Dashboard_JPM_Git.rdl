  <Code>Public Function GetBackGroundColor(ByVal p1 as Integer, ByVal pct as Integer, ByVal pct2 as Integer) as String

if p1&lt;pct2 then

	  return "#FF6666"

	  else

	  if p1&lt;pct then

	  return "Yellow"

	  else

	  return "#99FF99"

	  end if

	  end if

	  End Function

	  Public Function GetTextColor(ByVal p1 as Integer, ByVal pct as Integer, ByVal pct2 as Integer) as String

	  if p1&lt;pct2 then

   return "White"

else

       if p1&lt;pct then

          return "Black"

       else   
  
         return "Black"
      
      end if

end if

End Function
</Code>

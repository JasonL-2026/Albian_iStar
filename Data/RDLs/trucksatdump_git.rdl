<?xml version="1.0" encoding="utf-8"?>
<!--
  trucksatdump_git.rdl
  Albian SIC – Trucks at Dump Report
  Path: SIC/Datadump/trucksatdump_git.rdl

  Changes from original trucksatdump.rdl:
  - DataSource Initial Catalog set to ASEOperational
  - ShiftList dataset queries [CommonASE].[TrucksAtDump] directly;
    ShiftLabel derived from ShiftId (YYMMDDNNN) — no separate Shifts table needed
  - Main query targets [CommonASE].[TrucksAtDump] with
    WHERE ShiftId BETWEEN @StartShift AND @EndShift
  - Parameters StartShift / EndShift populated from ShiftList with friendly labels
    e.g. "2026-08-01 Day Shift", "2026-08-01 Night Shift"
  - Columns: ShiftId, DumpLocation, LogTime, NextLogTime, DurationSecond,
             Hos, RN, TrucksAtDump, TrucksInQueue, QStatus
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <Description>Trucks at Dump – dump-location activity for a selected shift range. Queries [ASEOperational].[CommonASE].[TrucksAtDump].</Description>
  <Author>Albian SIC</Author>
  <AutoRefresh>0</AutoRefresh>

  <!-- ============================================================
       DATA SOURCES
       ============================================================ -->
  <DataSources>
    <DataSource Name="SIC_DS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=#{SIC_DB_SERVER};Initial Catalog=ASEOperational;Integrated Security=SSPI</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>sic-datasource-git</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <!-- ============================================================
       DATA SETS
       ============================================================ -->
  <DataSets>

    <!-- Current shift: used as the default value for both parameters.
         ShiftId = YYMMDD + 001 (Day 06:00-17:59) or 002 (Night 18:00-05:59).
         Hours 00-05 belong to the previous calendar day's night shift. -->
    <DataSet Name="CurrentShift">
      <Query>
        <DataSourceName>SIC_DS</DataSourceName>
        <CommandText>
SELECT CAST(
    FORMAT(
        CASE WHEN DATEPART(HOUR, GETDATE()) &lt; 6
             THEN DATEADD(DAY, -1, GETDATE())
             ELSE GETDATE()
        END,
        'yyMMdd'
    ) +
    CASE WHEN DATEPART(HOUR, GETDATE()) &gt;= 6
              AND DATEPART(HOUR, GETDATE()) &lt; 18
         THEN '001'
         ELSE '002'
    END
AS INT) AS CurrentShiftId;
        </CommandText>
      </Query>
      <Fields>
        <Field Name="CurrentShiftId"> <DataField>CurrentShiftId</DataField> <rd:TypeName>System.Int32</rd:TypeName> </Field>
      </Fields>
    </DataSet>

    <!-- Main dataset: all rows for the selected shift range -->
    <DataSet Name="TrucksAtDump">
      <Query>
        <DataSourceName>SIC_DS</DataSourceName>
        <CommandText>
SELECT
    [ShiftId],
    [DumpLocation],
    [LogTime],
    [NextLogTime],
    [DurationSecond],
    [Hos],
    [RN],
    [TrucksAtDump],
    [TrucksInQueue],
    [QStatus]
FROM [CommonASE].[TrucksAtDump]
WHERE ShiftId BETWEEN @StartShift AND @EndShift
  AND TRY_CONVERT(datetime, [LogTime]) &gt;= DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
  AND TRY_CONVERT(datetime, [LogTime]) &lt; DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))
ORDER BY ShiftId, DumpLocation, LogTime;
        </CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartShift">
            <Value>=Parameters!StartShift.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndShift">
            <Value>=Parameters!EndShift.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="ShiftId">        <DataField>ShiftId</DataField>        <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="DumpLocation">   <DataField>DumpLocation</DataField>   <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="LogTime">        <DataField>LogTime</DataField>        <rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="NextLogTime">    <DataField>NextLogTime</DataField>    <rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="DurationSecond"> <DataField>DurationSecond</DataField> <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="Hos">            <DataField>Hos</DataField>            <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="RN">             <DataField>RN</DataField>             <rd:TypeName>System.Int64</rd:TypeName>   </Field>
        <Field Name="TrucksAtDump">   <DataField>TrucksAtDump</DataField>   <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="TrucksInQueue">  <DataField>TrucksInQueue</DataField>  <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="QStatus">        <DataField>QStatus</DataField>        <rd:TypeName>System.String</rd:TypeName>  </Field>
      </Fields>
    </DataSet>

  </DataSets>

  <!-- ============================================================
       REPORT PARAMETERS
       ============================================================ -->
  <ReportParameters>

    <ReportParameter Name="StartShift">
      <DataType>Integer</DataType>
      <Prompt>Start Shift</Prompt>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>CurrentShift</DataSetName>
          <ValueField>CurrentShiftId</ValueField>
        </DataSetReference>
      </DefaultValue>
    </ReportParameter>

    <ReportParameter Name="EndShift">
      <DataType>Integer</DataType>
      <Prompt>End Shift</Prompt>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>CurrentShift</DataSetName>
          <ValueField>CurrentShiftId</ValueField>
        </DataSetReference>
      </DefaultValue>
    </ReportParameter>

  </ReportParameters>

  <!-- ============================================================
       REPORT SECTIONS (required wrapper in 2016/01 schema)
       ============================================================ -->
  <ReportSections>
    <ReportSection>
      <Width>16in</Width>

      <Body>
        <ReportItems>

          <!-- Report title -->
          <Textbox Name="ReportTitle"><Top>0.1in</Top><Left>0in</Left><Width>9in</Width><Height>0.35in</Height><Paragraphs><Paragraph><TextRuns><TextRun><Value>Trucks at Dump</Value><Style><FontSize>14pt</FontSize>
              <FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox>

          <!-- Data table -->
          <Tablix Name="TrucksAtDumpTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- ShiftId -->
                <TablixColumn><Width>1.20in</Width></TablixColumn>  <!-- DumpLocation -->
                <TablixColumn><Width>1.30in</Width></TablixColumn>  <!-- LogTime -->
                <TablixColumn><Width>1.30in</Width></TablixColumn>  <!-- NextLogTime -->
                <TablixColumn><Width>1.10in</Width></TablixColumn>  <!-- DurationSecond -->
                <TablixColumn><Width>0.55in</Width></TablixColumn>  <!-- Hos -->
                <TablixColumn><Width>0.55in</Width></TablixColumn>  <!-- RN -->
                <TablixColumn><Width>1.10in</Width></TablixColumn>  <!-- TrucksAtDump -->
                <TablixColumn><Width>1.10in</Width></TablixColumn>  <!-- TrucksInQueue -->
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- QStatus -->
              </TablixColumns>
              <TablixRows>

                <!-- Header row -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hShiftId"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>ShiftId</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hDumpLocation"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>DumpLocation</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLogTime"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>LogTime</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hNextLogTime"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>NextLogTime</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hDurationSecond"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>DurationSecond</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hHos"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Hos</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hRN"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>RN</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hTrucksAtDump"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>TrucksAtDump</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hTrucksInQueue"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>TrucksInQueue</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hQStatus"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>QStatus</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Detail row -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dShiftId"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ShiftId.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dDumpLocation"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DumpLocation.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLogTime"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LogTime.Value,    "yyyy-MM-dd HH:mm:ss")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dNextLogTime"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!NextLogTime.Value,"yyyy-MM-dd HH:mm:ss")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dDurationSecond"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DurationSecond.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dHos"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Hos.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dRN"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!RN.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dTrucksAtDump"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TrucksAtDump.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dTrucksInQueue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TrucksInQueue.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dQStatus"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!QStatus.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                  <KeepTogether>true</KeepTogether>
                </TablixMember>
                <TablixMember>
                  <Group Name="Detail" />
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>TrucksAtDump</DataSetName>
            <NoRowsMessage>No data returned for the selected shift range.</NoRowsMessage>
            <Top>0.5in</Top>
            <Left>0in</Left>
            <Width>9.80in</Width>
          </Tablix>

        </ReportItems>
        <Height>6in</Height>
        <Style />
      </Body>

      <!-- Page layout -->
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>17in</PageWidth>
        <LeftMargin>0.5in</LeftMargin>
        <RightMargin>0.5in</RightMargin>
        <TopMargin>0.5in</TopMargin>
        <BottomMargin>0.5in</BottomMargin>
      </Page>

    </ReportSection>
  </ReportSections>

  <rd:ReportUnitType>Inch</rd:ReportUnitType>
  <rd:ReportID>trucksatdump-git-albian-sic</rd:ReportID>

</Report>

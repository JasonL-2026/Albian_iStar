<?xml version="1.0" encoding="utf-8"?>
<!--
  ShovelCoverageFactors_git.rdl
  Albian SIC – Shovel Coverage Factors Report
  Path: SIC/Datadump/ShovelCoverageFactors_git.rdl

  Based on trucksatdump_git.rdl conventions:
  - DataSource Initial Catalog set to ASEOperational
  - CurrentShift dataset computes the active ShiftId (YYMMDD + 001/002)
  - StartShift parameter defaults to the start of the current shift (= CurrentShiftId)
  - EndShift  parameter defaults to the current shift (= CurrentShiftId)
  - Main dataset queries [ASEOperational].[CommonASE].[ShovelCoverageFactors]
    with WHERE ShiftId BETWEEN @StartShift AND @EndShift
  - Columns: ShiftId, Id, Pit, LPTime, HOS, MatType, NodeFrom, NodeTo,
             LocationType, Location, PathRate, LoadRate, LPCoverage
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <Description>Shovel Coverage Factors – path/load rate coverage per shovel location for a selected shift range. Queries [ASEOperational].[CommonASE].[ShovelCoverageFactors].</Description>
  <Author>Albian SIC</Author>
  <AutoRefresh>0</AutoRefresh>

  <!-- ============================================================
       DATA SOURCES
       ============================================================ -->
  <DataSources>
    <DataSource Name="SIC_DS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=#{SIC_DB_SERVER};Initial Catalog=ASEOperational;Integrated Security=SSPI</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>c1a84f21-3b57-4e90-a993-7d6e09f1cc42</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <!-- ============================================================
       DATA SETS
       ============================================================ -->
  <DataSets>

    <!-- Current shift: used as the default value for both parameters.
         ShiftId = YYMMDD + 001 (Day 06:00-17:59) or 002 (Night 18:00-05:59).
         Hours 00-05 belong to the previous calendar day's night shift. -->
    <DataSet Name="CurrentShift">
      <Query>
        <DataSourceName>SIC_DS</DataSourceName>
        <CommandText>
SELECT CAST(
    FORMAT(
        CASE WHEN DATEPART(HOUR, GETDATE()) &lt; 6
             THEN DATEADD(DAY, -1, GETDATE())
             ELSE GETDATE()
        END,
        'yyMMdd'
    ) +
    CASE WHEN DATEPART(HOUR, GETDATE()) &gt;= 6
              AND DATEPART(HOUR, GETDATE()) &lt; 18
         THEN '001'
         ELSE '002'
    END
AS INT) AS CurrentShiftId;
        </CommandText>
      </Query>
      <Fields>
        <Field Name="CurrentShiftId"> <DataField>CurrentShiftId</DataField> <rd:TypeName>System.Int32</rd:TypeName> </Field>
      </Fields>
    </DataSet>

    <!-- Main dataset: all ShovelCoverageFactors rows for the selected shift range -->
    <DataSet Name="dsShovelCoverageFactors">
      <Query>
        <DataSourceName>SIC_DS</DataSourceName>
        <CommandText>
SELECT TOP (2147483647)
    [ShiftId],
    [Id],
    [Pit],
    [LPTime],
    [HOS],
    [MatType],
    [NodeFrom],
    [NodeTo],
    [LocationType],
    [Location],
    [PathRate],
    [LoadRate],
    [LPCoverage]
FROM [ASEOperational].[CommonASE].[ShovelCoverageFactors]
WHERE ShiftId BETWEEN @StartShift AND @EndShift
ORDER BY ShiftId, Pit, LPTime;
        </CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartShift">
            <Value>=Parameters!StartShift.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndShift">
            <Value>=Parameters!EndShift.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="ShiftId">      <DataField>ShiftId</DataField>      <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="Id">           <DataField>Id</DataField>           <rd:TypeName>System.Int64</rd:TypeName>   </Field>
        <Field Name="Pit">          <DataField>Pit</DataField>          <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="LPTime">       <DataField>LPTime</DataField>       <rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="HOS">          <DataField>HOS</DataField>          <rd:TypeName>System.Int32</rd:TypeName>   </Field>
        <Field Name="MatType">      <DataField>MatType</DataField>      <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="NodeFrom">     <DataField>NodeFrom</DataField>     <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="NodeTo">       <DataField>NodeTo</DataField>       <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="LocationType"> <DataField>LocationType</DataField> <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="Location">     <DataField>Location</DataField>     <rd:TypeName>System.String</rd:TypeName>  </Field>
        <Field Name="PathRate">     <DataField>PathRate</DataField>     <rd:TypeName>System.Decimal</rd:TypeName> </Field>
        <Field Name="LoadRate">     <DataField>LoadRate</DataField>     <rd:TypeName>System.Decimal</rd:TypeName> </Field>
        <Field Name="LPCoverage">   <DataField>LPCoverage</DataField>   <rd:TypeName>System.Decimal</rd:TypeName> </Field>
      </Fields>
    </DataSet>

  </DataSets>

  <!-- ============================================================
       REPORT PARAMETERS
       StartShift — defaults to the start of the current shift (CurrentShiftId)
       EndShift   — defaults to the current shift (CurrentShiftId)
       ============================================================ -->
  <ReportParameters>

    <ReportParameter Name="StartShift">
      <DataType>Integer</DataType>
      <Prompt>Start Shift</Prompt>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>CurrentShift</DataSetName>
          <ValueField>CurrentShiftId</ValueField>
        </DataSetReference>
      </DefaultValue>
    </ReportParameter>

    <ReportParameter Name="EndShift">
      <DataType>Integer</DataType>
      <Prompt>End Shift</Prompt>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>CurrentShift</DataSetName>
          <ValueField>CurrentShiftId</ValueField>
        </DataSetReference>
      </DefaultValue>
    </ReportParameter>

  </ReportParameters>

  <!-- ============================================================
       REPORT SECTIONS
       ============================================================ -->
  <ReportSections>
    <ReportSection>
      <Width>18in</Width>

      <Body>
        <ReportItems>

          <!-- Report title -->
          <Textbox Name="ReportTitle"><Top>0.1in</Top><Left>0in</Left><Width>12in</Width><Height>0.35in</Height><Paragraphs><Paragraph><TextRuns><TextRun><Value>Shovel Coverage Factors</Value><Style><FontSize>14pt</FontSize>
              <FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox>

          <!-- Data table -->
          <Tablix Name="ShovelCoverageFactorsTable">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- ShiftId -->
                <TablixColumn><Width>0.70in</Width></TablixColumn>  <!-- Id -->
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- Pit -->
                <TablixColumn><Width>1.30in</Width></TablixColumn>  <!-- LPTime -->
                <TablixColumn><Width>0.55in</Width></TablixColumn>  <!-- HOS -->
                <TablixColumn><Width>0.90in</Width></TablixColumn>  <!-- MatType -->
                <TablixColumn><Width>1.00in</Width></TablixColumn>  <!-- NodeFrom -->
                <TablixColumn><Width>1.00in</Width></TablixColumn>  <!-- NodeTo -->
                <TablixColumn><Width>1.00in</Width></TablixColumn>  <!-- LocationType -->
                <TablixColumn><Width>1.00in</Width></TablixColumn>  <!-- Location -->
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- PathRate -->
                <TablixColumn><Width>0.80in</Width></TablixColumn>  <!-- LoadRate -->
                <TablixColumn><Width>0.90in</Width></TablixColumn>  <!-- LPCoverage -->
              </TablixColumns>
              <TablixRows>

                <!-- Header row -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="hShiftId"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>ShiftId</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hId"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Id</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hPit"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Pit</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLPTime"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>LPTime</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hHOS"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>HOS</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hMatType"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>MatType</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hNodeFrom"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>NodeFrom</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hNodeTo"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>NodeTo</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLocationType"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>LocationType</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLocation"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>Location</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hPathRate"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>PathRate</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLoadRate"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>LoadRate</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="hLPCoverage"><Style><BackgroundColor>#4472C4</BackgroundColor></Style><Paragraphs><Paragraph><TextRuns><TextRun><Value>LPCoverage</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Detail row -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="dShiftId"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ShiftId.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dId"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Id.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dPit"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Pit.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLPTime"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LPTime.Value,"yyyy-MM-dd HH:mm:ss")</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dHOS"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!HOS.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dMatType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!MatType.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dNodeFrom"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!NodeFrom.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dNodeTo"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!NodeTo.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLocationType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LocationType.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLocation"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Location.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style/></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dPathRate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PathRate.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLoadRate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LoadRate.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="dLPCoverage"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LPCoverage.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><CanGrow>true</CanGrow></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                  <KeepTogether>true</KeepTogether>
                </TablixMember>
                <TablixMember>
                  <Group Name="Detail" />
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>dsShovelCoverageFactors</DataSetName>
            <NoRowsMessage>No data returned for the selected shift range.</NoRowsMessage>
            <Top>0.5in</Top>
            <Left>0in</Left>
            <Width>11.55in</Width>
          </Tablix>

        </ReportItems>
        <Height>6in</Height>

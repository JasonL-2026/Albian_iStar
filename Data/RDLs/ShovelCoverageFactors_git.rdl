        </Field>
        <Field Name="pit">
          <DataField>pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Excav">
          <DataField>Excav</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DigLoc">
          <DataField>DigLoc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GradeMaterialType">

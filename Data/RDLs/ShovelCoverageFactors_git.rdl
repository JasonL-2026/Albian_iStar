        <Field Name="LPMode">
          <DataField>LPMode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="LPCoverage">
          <DataField>LPCoverage</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="StartShift">
      <DataType>Integer</DataType>
      <Prompt>Start Shift</Prompt>
      <DefaultValue>
          <Values>
            <Value>=CInt(Format(DateSerial(Year(DateAdd("m",-1,Now())),Month(DateAdd("m",-1,Now())),1),"yyMMdd") & "001")</Value>
          </Values>
        </DefaultValue>
    </ReportParameter>
    <ReportParameter Name="EndShift">
      <DataType>Integer</DataType>
      <Prompt>End Shift</Prompt>
      <DefaultValue>
          <Values>
            <Value>=CInt(Format(DateSerial(Year(DateAdd("m",-1,Now())),Month(DateAdd("m",-1,Now()))+1,0),"yyMMdd") & "002")</Value>
          </Values>
        </DefaultValue>
    </ReportParameter>
  </ReportParameters>

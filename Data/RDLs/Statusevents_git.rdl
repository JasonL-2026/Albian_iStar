<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="SICDataSource">
      <DataSourceReference>/PROD/Albian D6 Dispatch/Auxiliary/Data Sources/DispatchDataSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>95a4a90f-417a-4985-8fa5-35fdabccfa4e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="CurrentShift">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT CAST(
    FORMAT(
        CASE WHEN DATEPART(HOUR, GETDATE()) &lt; 6
             THEN DATEADD(DAY, -1, GETDATE())
             ELSE GETDATE()
        END,
        'yyMMdd'
    ) +
    CASE WHEN DATEPART(HOUR, GETDATE()) &gt;= 6
              AND DATEPART(HOUR, GETDATE()) &lt; 18
         THEN '001'
         ELSE '002'
    END
AS INT) AS CurrentShiftId;</CommandText>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="CurrentShiftId">
          <DataField>CurrentShiftId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ShiftList">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT DISTINCT
    TRY_CONVERT(int, [ShiftId]) AS ShiftId,
    CONVERT(varchar(10), TRY_CONVERT(date, LEFT(RIGHT('000000000' + CAST(TRY_CONVERT(int, [ShiftId]) AS varchar(9)), 9), 6), 12), 23) +
    CASE WHEN RIGHT('000000000' + CAST(TRY_CONVERT(int, [ShiftId]) AS varchar(9)), 3) = '001'
         THEN ' Day Shift'
         ELSE ' Night Shift'
    END AS ShiftLabel
FROM [ASEOperational].[dispowner].[SIC_ShiftEQMTStatusEvents]
WHERE TRY_CONVERT(int, [ShiftId]) IS NOT NULL
  AND TRY_CONVERT(datetime, [TimeStamp]) &gt;= DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
  AND TRY_CONVERT(datetime, [TimeStamp]) &lt; DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))
ORDER BY ShiftId DESC;</CommandText>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="ShiftId">
          <DataField>ShiftId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ShiftLabel">
          <DataField>ShiftLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsStatusevents">
      <Query>
        <DataSourceName>SICDataSource</DataSourceName>
        <CommandText>SELECT *
FROM [ASEOperational].[dispowner].[SIC_ShiftEQMTStatusEvents]
WHERE TRY_CONVERT(int, [ShiftId]) BETWEEN @StartShift AND @EndShift
  AND TRY_CONVERT(datetime, [TimeStamp]) &gt;= DATEFROMPARTS(YEAR(DATEADD(MONTH, -1, GETDATE())), MONTH(DATEADD(MONTH, -1, GETDATE())), 1)
  AND TRY_CONVERT(datetime, [TimeStamp]) &lt; DATEADD(MONTH, 1, DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1))</CommandText>
        <QueryParameters>
          <QueryParameter Name="@StartShift">
            <Value>=Parameters!StartShift.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndShift">
            <Value>=Parameters!EndShift.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <Timeout>0</Timeout>
      </Query>
      <Fields>
        <Field Name="ShiftId">
          <DataField>ShiftId</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Eqmt">
          <DataField>Eqmt</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartTime">
          <DataField>TimeStamp</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Reason">
          <DataField>Reason</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Duration">
          <DataField>Duration</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="FieldComment">
          <DataField>FieldComment</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TimeCat">
          <DataField>TimeCat</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ASEStatus">
          <DataField>ASEStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ExpectedDuration">
          <DataField>ExpectedDuration</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OperatorName">
          <DataField>OperatorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EqmtType">
          <DataField>EqmtType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Unit">
          <DataField>Unit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Crew">
          <DataField>Crew</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Pit">
          <DataField>Pit</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
